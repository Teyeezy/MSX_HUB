-- === STANDALONE BLACK SCREEN & STATS GUI (Perfect Match) ===
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 1. สร้าง ScreenGui หลัก
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FarmStatsGui"
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- 2. สร้างพื้นหลังสีดำเต็มจอ
local BlackBackground = Instance.new("Frame")
BlackBackground.Name = "Background"
BlackBackground.Size = UDim2.new(1, 0, 1, 0)
BlackBackground.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
BlackBackground.BorderSizePixel = 0
BlackBackground.Parent = ScreenGui

-- 3. สร้างกล่องข้อความแสดงผล
local TextLabel = Instance.new("TextLabel")
TextLabel.Name = "StatusText"
TextLabel.Size = UDim2.new(0, 600, 0, 220)
TextLabel.Position = UDim2.new(0.5, -300, 0.5, -110)
TextLabel.BackgroundTransparency = 1
TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TextLabel.TextSize = 24
TextLabel.Font = Enum.Font.GothamBold
TextLabel.TextXAlignment = Enum.TextXAlignment.Center
TextLabel.TextYAlignment = Enum.TextYAlignment.Center
TextLabel.Text = "🤖 กำลังเปิดหน้าจอสีดำ..."
TextLabel.Parent = ScreenGui

-- ตัวแปรสถานะหลัก (สคริปต์อื่นสามารถเปลี่ยนข้อความผ่าน _G.BotStatus ได้)
if not _G.BotStatus then
    _G.BotStatus = "ระบบ GUI พร้อมใช้งาน"
end

-- 4. ระบบอัปเดตหน้าจอแบบเรียลไทม์ (จับเวลา + ดึงค่า Emeralds จาก UI ของเกมโดยตรง)
local startTime = os.clock()
task.spawn(function()
    while true do
        task.wait(0.3)
        local elapsedSeconds = math.floor(os.clock() - startTime)
        local minutes = math.floor(elapsedSeconds / 60)
        local seconds = elapsedSeconds % 60
        local timeString = string.format("%02d:%02d", minutes, seconds)
        
        -- ดึงค่า Emeralds จาก TextLabel ที่เกมใช้แสดงผลอยู่จริง
        local emeralds = "0"
        pcall(function()
            -- อิงตามโครงสร้างใน PlayerGui ของเกมนี้
            local main = PlayerGui:FindFirstChild("Main")
            if main then
                local display = main:FindFirstChild("BloodGemDisplay") -- หรือโฟลเดอร์แสดงผล Emeralds
                if display then
                    local count = display:FindFirstChild("Count")
                    if count and count:IsA("TextLabel") then
                        emeralds = count.Text
                    end
                end
            end
            
            -- ถ้ายังไม่เจอ ให้ลองสแกนหา TextLabel ที่มีชื่อหรือข้อความใกล้เคียง
            if emeralds == "0" then
                for _, desc in ipairs(PlayerGui:GetDescendants()) do
                    if desc:IsA("TextLabel") and (desc.Name == "Count" or desc.Name:lower():find("emerald") or desc.Name:lower():find("gem")) then
                        if desc.Text ~= "" and desc.Text ~= "0" then
                            emeralds = desc.Text
                            break
                        end
                    end
                end
            end
        end)
        
        -- แสดงผลบน GUI หน้าจอดำ
        TextLabel.Text = "🤖 ระบบจำลองหน้าจอดำ\n\n" ..
                         "📌 สถานะ: " .. tostring(_G.BotStatus) .. "\n" ..
                         "🟢 Emeralds: " .. tostring(emeralds) .. "\n" ..
                         "⏱️ เวลาที่ใช้: " .. timeString
    end
end)
