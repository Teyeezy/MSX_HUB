    if not CONFIG.ENABLE_AUTO_BOOST or isHoldingStopBox then return end
    if os.clock() - lastBoostCmdAt < 0.2 then return end
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    local phys = rcd and rcd.phys
    if not phys then return end
    if phys.boosting or phys.throttle <= 0 or phys.drift then return end
    if math.abs(phys.steerIn or 0) > 0.32 then return end
    local spState = EconomyRules.lastSPState
    if not spState or not spState.sp then return end
    local p = phys.p or {}
    local needSP = math.max(p.btNeedSP or 50, 20)
    if spState.sp >= needSP then
        lastBoostCmdAt = os.clock()
        local myCar = workspace:FindFirstChild("MyCar")
        if myCar then pcall(function() myCar:SetAttribute("AutoCmd", "boost") end) end
        local boostFn = getBoostFn()
        if boostFn then pcall(boostFn) end
    end
end

local cachedCarRoot = nil
local adState = nil
pcall(function()
    if debug and debug.getupvalue and type(AutoDrive.debugState) == "function" then
