local function setButtonState(running)
    if running then
        TweenService:Create(ToggleBtn, TweenInfo.new(0.25), { BackgroundColor3 = Color3.fromRGB(200, 60, 60) }):Play()
        TweenService:Create(btnGrad, TweenInfo.new(0.25), {
            Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(240, 80, 80)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 40, 40)),
            }
        }):Play()
        ToggleBtn.Text = "■  ปิดบอท"
        Status.Text = "● กำลังทำงาน..."
        TweenService:Create(Status, TweenInfo.new(0.2), { TextColor3 = Color3.fromRGB(120, 255, 140) }):Play()
        stroke.Color = Color3.fromRGB(50, 220, 90)
        glowStroke.Color = Color3.fromRGB(80, 255, 120)
        startBlink()
    else
        TweenService:Create(ToggleBtn, TweenInfo.new(0.25), { BackgroundColor3 = Color3.fromRGB(50, 170, 90) }):Play()
        TweenService:Create(btnGrad, TweenInfo.new(0.25), {
            Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 200, 110)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 140, 70)),
            }
        }):Play()
        ToggleBtn.Text = "▶  เปิดบอท"
        Status.Text = "● ปิดอยู่"
        TweenService:Create(Status, TweenInfo.new(0.2), { TextColor3 = Color3.fromRGB(200, 200, 200) }):Play()
        stroke.Color = Color3.fromRGB(200, 60, 60)
        glowStroke.Color = Color3.fromRGB(255, 80, 80)
        stopBlink()
    end
end

local function startBot()
    if isGuiRunning then return end
    isGuiRunning = true
    _G.AutoQuestRunning = true
    isRunning = true
    setButtonState(true)
    print("[AutoQuest] >>> เริ่มบอท <<<")
    mainThread = task.spawn(function()
        local cycleCount = 0
        while _G.AutoQuestRunning do
            local currentLv = getPlayerLevel()
            cycleCount = cycleCount + 1
            print(string.format("\n>>> รอบ Min R Lv.20 (#%d) [Lv.%d] <<<", cycleCount, currentLv))
            local ok, err = pcall(runOneQuestCycle)
            if not ok then
                warn("[AutoQuest] เกิดข้อผิดพลาด:", err)
                pcall(function() AutoDrive.stop("error_recover") end)
                task.wait(1.5)
            end
            task.wait(CONFIG.LOOP_DELAY)
        end
        pcall(function() AutoDrive.stop("exit") end)
        isGuiRunning = false
        setButtonState(false)
    end)
end

local function stopBot()
    if not isGuiRunning then return end
    _G.AutoQuestRunning = false
    isRunning = false
    stopNpcPositionHold()
    pcall(function()
        if mainThread then task.cancel(mainThread) end
    end)
    pcall(function() AutoDrive.stop("user_stop") end)
    setButtonState(false)
    print("[AutoQuest] >>> หยุดบอท <<<")
    isGuiRunning = false
end

ToggleBtn.MouseButton1Click:Connect(function()
    if isGuiRunning then stopBot() else startBot() end
end)

_G.RaycityAutoQuestStop = function()
    _G.AutoQuestRunning = false
    isRunning = false
    isGuiRunning = false
    stopNpcPositionHold()
    pcall(function() RunService:UnbindFromRenderStep("RaycityRoadLock") end)
    if minimizeFixConn then pcall(function() minimizeFixConn:Disconnect() end) end
    if mxPushConn then pcall(function() mxPushConn:Disconnect() end) end
    if trafficSteppedConn then pcall(function() trafficSteppedConn:Disconnect() end) end
    if cityDescendantConn then pcall(function() cityDescendantConn:Disconnect() end) end
    if krColDescendantConn then pcall(function() krColDescendantConn:Disconnect() end) end
    pcall(function() AutoDrive.stop("user_stop") end)
    stopBlink()
    safeDestroyGui()
    print("[AutoQuest] หยุดเรียบร้อย")
end

