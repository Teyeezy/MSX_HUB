local function isAutoDriveActive()
    if type(AutoDrive.isActive) ~= "function" then return nil end
    local ok, result = pcall(AutoDrive.isActive)
    return ok and result or nil
end

AutoDrive.canCruise = function() return true end

local function applyAutoDriveParams(isStop)
    AutoDrive.C.nearDestM = isStop and 0.2 or 1.5
    AutoDrive.C.arriveNearM = isStop and 1.5 or 2.5
    AutoDrive.C.arriveSlowM = isStop and 1.0 or 1.2
    AutoDrive.C.arriveSlowerM = isStop and 0.5 or 0.6
    AutoDrive.options.arriveBrake = false
    AutoDrive.options.evasions = false  
    AutoDrive.C.maxSpeed = CONFIG.CRUISE_SPEED_MPS
    AutoDrive.C.cap1 = 120.0
    AutoDrive.C.cap2 = 90.0
    AutoDrive.C.cap3 = 50.0
    AutoDrive.C.lookAhead = 25
    AutoDrive.options.velocityAssist = true
    AutoDrive.options.aiDrift = false
    AutoDrive.options.uturnSweep = false
    AutoDrive.canCruise = function() return true end
end
applyAutoDriveParams(false)

local function getQuestState()
    local rq = (getrenv and getrenv().shared.RBRCQuest) or shared.RBRCQuest
    if rq and type(rq.state) == "function" then
        local ok, state = pcall(rq.state)
        if ok and type(state) == "table" then return state end
    end
    return nil
end

local dummyHook = function() end
local function maintainHooks()
    local renvShared = (getrenv and getrenv().shared) or shared
    if renvShared and renvShared.RCDrivePairHooks then
        renvShared.RCDrivePairHooks.traffic = dummyHook
        renvShared.RCDrivePairHooks.mov = dummyHook
    end
    workspace:SetAttribute("RaycityWallGuardOff", true)
    workspace:SetAttribute("RCWallMapData", false)
    workspace:SetAttribute("RCNativeWorldHit", false)

    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    if rcd and rcd.phys then
        local phys = rcd.phys
        if phys.throttle > 0 and phys.gear == 0 then phys.gear = 1 end
        if phys.p then
            phys.p.redRpm = math.max(phys.p.redRpm or 6000, 12000)
            phys.p.maxRpm = math.max(phys.p.maxRpm or 7830, 14000)
            phys.p.vmax = math.max(phys.p.vmax or 100, 150)
            phys.p.btPower = math.max(phys.p.btPower or 2.5, 5.0)
            phys.p.btOver = math.max(phys.p.btOver or 1.12, 1.8)
        end
        phys.torqueBonus = math.max(phys.torqueBonus or 0, 1200)
        phys.gripScale = math.max(phys.gripScale or 1, 3.5)
    end
end

local function getCarRoot()
    local car = workspace:FindFirstChild("MyCar")
    if not car then return nil end
    if car:IsA("BasePart") then return car end
    if car:IsA("Model") then
        return car.PrimaryPart or car:FindFirstChild("Root") or car:FindFirstChild("Hull")
    end
    return nil
end

local function getCarState()
    local root = getCarRoot()
    return root and root.Position or nil
end

local function getLiveNpcPos()
    local ok, pos = pcall(function()
        local npcs = workspace:FindFirstChild("RBRCNpcs")
        if not npcs then return nil end
        local npc = npcs:FindFirstChild(CONFIG.NPC_NAME) or npcs:FindFirstChild("Npc_940105") or npcs:FindFirstChild(CONFIG.NPC_ID)
        if not npc then return nil end
        local root = npc:FindFirstChild("Root") or npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart")
        return root and root.Position or nil
    end)
    return (ok and typeof(pos) == "Vector3") and pos or nil
end

local function getNpcPos()
    return getLiveNpcPos() or CONFIG.NPC_POS
end

local function parseVector3(val)
    if typeof(val) == "Vector3" then return val end
    if type(val) ~= "string" then return nil end
    local x, y, z = string.match(val, "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
    return (x and y and z) and Vector3.new(tonumber(x), tonumber(y), tonumber(z)) or nil
end

local function driveToNpcSmooth(timeout)
    if not isRunning or not _G.AutoQuestRunning then return false end
    timeout = timeout or 60
    local npcPos = getNpcPos()
    local carPos = getCarState()
    if not carPos then return false end

    if (carPos - npcPos).Magnitude <= 6.0 then return true end

    applyAutoDriveParams(true)
    AutoDrive.C.maxSpeed = CONFIG.CRUISE_SPEED_MPS
    AutoDrive.request(npcPos, { snap = false, stopNavOnCancel = false })
    AutoDrive.start()

    local startTime = os.clock()
    while isRunning and _G.AutoQuestRunning do
        task.wait(0.05)
        maintainHooks()
        local currentPos = getCarState()
        if not currentPos then break end
        local curDistToNpc = (currentPos - getNpcPos()).Magnitude

        if curDistToNpc <= 6.0 then
            pcall(function() AutoDrive.stop("reached_npc") end)
            return true
        end

        if isAutoDriveActive() == false and curDistToNpc > 6.0 then
            AutoDrive.request(getNpcPos(), { snap = false, stopNavOnCancel = false })
            AutoDrive.start()
        end

        if os.clock() - startTime > timeout then break end
    end
    return false
end

local function ensureQuestAccepted()
    local st = getQuestState()
    if st and (st.state == "running" or st.state == "boarding") and st.questId == CONFIG.QUEST_ID then
        return true
    end

    print(string.format("[AutoQuest] กำลังเดินทางไปรับเควส Min R Lv.20 (%s)...", CONFIG.QUEST_ID))

    for attempt = 1, CONFIG.MAX_ACCEPT_RETRIES do
        if not isRunning or not _G.AutoQuestRunning then return false end

        st = getQuestState()
        if st and (st.state == "running" or st.state == "boarding") and st.questId == CONFIG.QUEST_ID then
            return true
        end

        local carPos = getCarState()
        local npcPos = getNpcPos()
        local distToNpc = carPos and (carPos - npcPos).Magnitude or 999

        if distToNpc > 6.5 then
            driveToNpcSmooth(45)
            task.wait(0.3)
            carPos = getCarState()
        end

        if QuestRequest and carPos then
            pcall(function()
                QuestRequest:InvokeServer({op = "talk", npcId = CONFIG.NPC_ID, carPos = carPos})
            end)
            task.wait(0.15)
            pcall(function()
                QuestRequest:InvokeServer({op = "accept", questId = CONFIG.QUEST_ID, npcId = CONFIG.NPC_ID, carPos = carPos})
            end)
            task.wait(0.15)
            pcall(function()
                QuestRequest:InvokeServer({op = "boarded", questId = CONFIG.QUEST_ID, carPos = carPos})
            end)
        end

        local rq = (getrenv and getrenv().shared.RBRCQuest) or shared.RBRCQuest
        if rq and rq.talk then pcall(rq.talk, CONFIG.NPC_ID) end

        for waitStep = 1, 20 do
            task.wait(0.1)
            st = getQuestState()
            if st and st.questId == CONFIG.QUEST_ID and (st.state == "running" or st.state == "boarding") then
                print("[AutoQuest] รับเควส Min R สำเร็จ! เริ่มต้นฟาร์มเส้นทางทันที!")
                return true
            end
        end
        task.wait(0.4)
    end
    return false
end

local function getActiveObjective(st)
    if not st or (st.state ~= "running" and st.state ~= "boarding") then return nil end
    local q = st.q
    if q and q.objectives then
        for _, obj in ipairs(q.objectives) do
            if obj.dest and obj.dest.target and not obj.passive then
                local objState = st.objectives and st.objectives[obj.idx]
                if not (objState and objState.done) and (obj.step == st.step or st.step == 0) then
                    local targetPos = parseVector3(obj.dest.target)
                    if targetPos then
                        return {
                            idx = obj.idx,
                            step = obj.step or st.step,
                            target = targetPos,
                            isStop = (obj.dest.stop == true) or (obj.dest.pillar == "stop"),
                        }
                    end
                end
            end
        end
    end
    return nil
end

local function runOneQuestCycle()
    local accepted = ensureQuestAccepted()
    if not accepted then
        task.wait(1.0)
        return
    end

    print(string.format("[AutoQuest] เริ่มทำเควส Min R Lv.20 (%s)!", CONFIG.QUEST_ID))
    AutoDrive.C.maxSpeed = CONFIG.CRUISE_SPEED_MPS

    local currentActiveIdx = nil
    local currentActiveTarget = nil
    local currentActiveIsStop = false
    local questStateUnknownSince = nil

    while isRunning and _G.AutoQuestRunning do
        task.wait(0.05)
        maintainHooks()

        local st = getQuestState()
        if not st then
            questStateUnknownSince = questStateUnknownSince or os.clock()
            if os.clock() - questStateUnknownSince >= CONFIG.QUEST_STATE_UNKNOWN_TIMEOUT then
                warn("[AutoQuest] ไม่พบสถานะเควส -> จบรอบกลับไปรับเควสใหม่")
                break
            end
            task.wait(0.1)
            continue
        end
        questStateUnknownSince = nil

        if st.state ~= "running" and st.state ~= "boarding" then break end

        local activeObj = getActiveObjective(st)
        if not activeObj then
            task.wait(0.1)
            continue
        end

        if activeObj.idx ~= currentActiveIdx or currentActiveTarget == nil or (activeObj.target - currentActiveTarget).Magnitude > 2 then
            currentActiveIdx = activeObj.idx
            currentActiveTarget = activeObj.target
            currentActiveIsStop = activeObj.isStop

            applyAutoDriveParams(activeObj.isStop)
            AutoDrive.request(activeObj.target, { snap = not activeObj.isStop, stopNavOnCancel = false })
            AutoDrive.start()
        end

        local carPosNow = getCarState()
        local distToTarget = carPosNow and (carPosNow - activeObj.target).Magnitude or 999

        if activeObj.isStop and distToTarget <= 5.0 then
            pcall(function() AutoDrive.stop("reached_stop") end)
            task.wait(0.5)
            break
        end

        if isAutoDriveActive() == false then
            AutoDrive.request(activeObj.target, { snap = not activeObj.isStop, stopNavOnCancel = false })
            AutoDrive.start()
        end
    end

    AutoDrive.stop("quest_cycle_done")
    task.wait(CONFIG.LOOP_DELAY)
end

