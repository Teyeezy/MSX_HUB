local function startBot()
    if isGuiRunning then return end
    isGuiRunning = true
    _G.AutoQuestRunning = true
    isRunning = true
    STATS.isRunning = true
    
    if not STATS.startTime or not _G.HasRunBefore then
        STATS.startTime = os.time()
        _G.HasRunBefore = true
    end
    
    setButtonState(true)
    print("[MSX HUB] >>> STARTED <<<")
    
    mainThread = task.spawn(function()
        local cycleCount = 0
        while _G.AutoQuestRunning do
            local currentLv = getPlayerLevel()
            cycleCount = cycleCount + 1
            print(string.format("\n>>> CYCLE (#%d) [Lv.%d] <<<", cycleCount, currentLv))
            local ok, err = pcall(runOneQuestCycle)
            if not ok then
                warn("[MSX HUB] Error:", err)
                humanWait(1.5, 0.5)
            end
            task.wait(CONFIG.LOOP_DELAY)
        end
        isGuiRunning = false
        setButtonState(false)
    end)
end

local function stopBot()
    if not isGuiRunning then return end
    _G.AutoQuestRunning = false
    isRunning = false
    isGuiRunning = false
    STATS.isRunning = false
    if mainThread then task.cancel(mainThread) end
    setButtonState(false)
    print("[MSX HUB] >>> STOPPED <<<")
end

