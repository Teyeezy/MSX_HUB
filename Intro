-- Animation state
local isGuiRunning = false
local mainThread = nil
local blinkConn = nil

-- 🎨 ฟังก์ชันกระพริบ UI
local function startBlink()
    if blinkConn then return end
    local pulseTime = 0.6
    local tweenIn = TweenInfo.new(pulseTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    local tweenStroke = TweenService:Create(stroke, tweenIn, { Transparency = 0.6, Thickness = 3 })
    local tweenGlow = TweenService:Create(glowStroke, tweenIn, { Transparency = 0.3, Thickness = 6 })
    tweenStroke:Play()
    tweenGlow:Play()
    blinkConn = { tweenStroke, tweenGlow }
end

local function stopBlink()
    if blinkConn then
        for _, tw in ipairs(blinkConn) do
            pcall(function() tw:Cancel() end)
        end
        blinkConn = nil
    end
    stroke.Transparency = 0
    stroke.Thickness = 2
    glowStroke.Transparency = 0.7
    glowStroke.Thickness = 4
end

-- 🎨 Animation ตอน hover
