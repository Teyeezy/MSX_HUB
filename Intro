local isSellingInventory = false
local function sellAllInventoryItems()
    if not CONFIG.ENABLE_AUTO_SELL or isSellingInventory then return 0, 0 end
    isSellingInventory = true
    local soldCount, totalRainEarned = 0, 0
    pcall(function()
        local rs = (getrenv and getrenv().shared.RaycityShop) or shared.RaycityShop
        if not rs or type(rs.request) ~= "function" then return end
        local prof = rs.profile and rs.profile.get and rs.profile.get()
        local inv = prof and prof.inventory
        if type(inv) ~= "table" then return end
        local invSize = tonumber(prof.invSize) or 30
        for slotIdx = 1, invSize do
            local item = inv[tostring(slotIdx)] or inv[slotIdx]
            if type(item) == "table" and item.uid then
                local canSell = CONFIG.SELL_BOUND_ITEMS or not item.bound
                if canSell then
                    local countToSell = math.max(1, tonumber(item.count) or 1)
                    local res = rs.request("sell", { cell = slotIdx, count = countToSell, uid = item.uid })
                    if res and res.ok then
                        soldCount = soldCount + countToSell
                        totalRainEarned = totalRainEarned + (tonumber(res.total) or 0)
                        STATS.totalRain = STATS.totalRain + (tonumber(res.total) or 0)
                    end
                end
            end
        end
    end)
    isSellingInventory = false
    return soldCount, totalRainEarned
end

local isClaimingDrops = false
local function claimAllDropsAndSellInventory()
    if (not CONFIG.ENABLE_AUTO_LOOT and not CONFIG.ENABLE_AUTO_SELL) or isClaimingDrops then return false end
    isClaimingDrops = true
    local claimedAny = false
    pcall(function()
        if CONFIG.ENABLE_AUTO_LOOT then
            local dropGetAllFn, dropTbl = resolveMissionExtraDropHandles()
            if type(dropTbl) == "table" then
                local pendingEntries = {}
                for dropId, entry in pairs(dropTbl) do
                    if type(entry) == "table" and (entry.mode == "pick" or entry.mode == nil) then
                        table.insert(pendingEntries, { id = dropId, entry = entry })
                    end
                end
                if #pendingEntries > 0 then
                    if CONFIG.ENABLE_AUTO_SELL then sellAllInventoryItems() end
                    for _, item in ipairs(pendingEntries) do
                        local dropId, entry = item.id, item.entry
                        if type(dropGetAllFn) == "function" and not entry.busy then
                            pcall(dropGetAllFn, entry)
                            claimedAny = true
                        end
                        if dropTbl[dropId] ~= nil and MXRequest then
                            local ok, res = pcall(function() return MXRequest:InvokeServer("pick", { id = dropId }) end)
                            if ok and type(res) == "table" and res.ok then
                                claimedAny = true
                                dropTbl[dropId] = nil
                            end
                        end
                    end
                end
            end
        end
        if CONFIG.ENABLE_AUTO_SELL then sellAllInventoryItems() end
    end)
    isClaimingDrops = false
    return claimedAny
end

