local function getCarRootCached()
    if cachedCarRoot and cachedCarRoot.Parent then return cachedCarRoot end
    cachedCarRoot = getCarRoot()
    return cachedCarRoot
end

local function pathPointAt(path, s)
    local pts, cum, n = path.pts, path.cum, path.n
    if s <= 0 then return pts[1] end
    if s >= path.len then return pts[n] end
    local lo, hi = 1, n
    while hi - lo > 1 do
        local mid = (lo + hi) // 2
        if cum[mid] <= s then lo = mid else hi = mid end
    end
    local seg = cum[hi] - cum[lo]
    return pts[lo]:Lerp(pts[hi], seg > 0 and (s - cum[lo]) / seg or 0)
end

local function sanitizePath(path)
    if not path or path._sanitized or not path.pts or not path.n or path.n < 4 then return end
    local pts, cum, n = path.pts, path.cum, path.n
    local newPts = {}
    local i = 1
    while i <= n do
        newPts[#newPts + 1] = pts[i]
        local jumpTo = nil
        local maxJ = math.min(n - 1, i + 12)
        for j = maxJ, i + 2, -1 do
            local pathDist = cum[j] - cum[i]
            if pathDist > 20 then
                local dx, dz = pts[j].X - pts[i].X, pts[j].Z - pts[i].Z
                local directDist = math.sqrt(dx * dx + dz * dz) / 2
                if directDist < 16 and pathDist > directDist * 3 then jumpTo = j; break end
            end
        end
        if jumpTo then i = jumpTo + 1 else i = i + 1 end
    end
    if #newPts < n and #newPts >= 2 then
        local newCum = {0}
        local total = 0
        for k = 2, #newPts do
            total = total + (newPts[k] - newPts[k - 1]).Magnitude / 2
            newCum[k] = total
        end
        path.pts = newPts
        path.cum = newCum
        path.n = #newPts
        path.len = total
        if adState then adState.pathHint = 1 end
    end
    path._sanitized = true
end

local function pathProject(path, pos, hint)
    local pts, cum, n = path.pts, path.cum, path.n
    local i0 = hint and math.max(1, hint - 3) or 1
    local i1 = hint and math.min(n - 1, hint + 35) or (n - 1)
    local px, pz = pos.X, pos.Z
    local bestD, bestS, bestIdx = math.huge, 0, i0
    for i = i0, i1 do
        local a, b = pts[i], pts[i + 1]
        local dx, dz = b.X - a.X, b.Z - a.Z
        local l2 = dx * dx + dz * dz
        local t = l2 > 1e-8 and math.clamp(((px - a.X) * dx + (pz - a.Z) * dz) / l2, 0, 1) or 0
        local cx, cz = a.X + dx * t - px, a.Z + dz * t - pz
        local d = cx * cx + cz * cz
        if d < bestD then
            bestD = d
            bestS = cum[i] + (cum[i + 1] - cum[i]) * t
            bestIdx = i
        end
    end
    return bestS, math.sqrt(bestD), bestIdx
end

local function flatDir(v, fallback)
    local m = math.sqrt(v.X * v.X + v.Z * v.Z)
    if m > 1e-4 then return Vector3.new(v.X / m, 0, v.Z / m) end
    return fallback
end

local function applyCorneringGripAssist()
    if not CONFIG.ENABLE_CORNERING_ASSIST or npcPositionHoldConn ~= nil or isHoldingStopBox then return end
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    local phys = rcd and rcd.phys
    if not phys or not phys.v then return end
    if phys.p then
        phys.p.redRpm = math.max(phys.p.redRpm or 6000, 9800)
        phys.p.maxRpm = math.max(phys.p.maxRpm or 7830, 11500)
        phys.p.vmax = math.max(phys.p.vmax or 100, 135)
        phys.p.btPower = math.max(phys.p.btPower or 2.5, 4.2)
        phys.p.btOver = math.max(phys.p.btOver or 1.12, 1.45)
    end
    phys.torqueBonus = math.max(phys.torqueBonus or 0, 750)
    phys.gripScale = math.max(phys.gripScale or 1, 3.0)
    if not adState or not adState.active or adState.near then return end
    local path = adState.path
    if not path or not path.n or path.n < 2 or not path.len or path.len < 2 then return end
    if not path._sanitized then sanitizePath(path) end
    local root = getCarRootCached()
    if not root or root.Anchored then return end
    local car = rcd.car
    if typeof(car) ~= "Instance" or not car.Parent then car = workspace:FindFirstChild("MyCar") end
    if not car then return end
    local cf = root.CFrame
    local pos = cf.Position
    local fwd = flatDir(cf.LookVector, Vector3.new(0, 0, -1))
    local v = phys.v
    local vFlat = Vector3.new(v.X, 0, v.Z)
    local speed = vFlat.Magnitude
    local sNow, lat, segIdx = pathProject(path, pos, adState.pathHint)
    adState.pathHint = segIdx
    local remain = path.len - sNow
    if remain < 1.5 then return end
    local scanLen = math.clamp(speed * 1.5, 28, 95)
    local here = pathPointAt(path, sNow)
    local prevDir = flatDir(pathPointAt(path, sNow + 4) - here, fwd)
    local minCos = 1
    local s = sNow + 4
    while s < sNow + scanLen do
        local a = pathPointAt(path, s)
        local b = pathPointAt(path, s + 4)
        local d = flatDir(b - a, prevDir)
        local c = d:Dot(prevDir)
        if c < minCos then minCos = c end
        prevDir = d
        s = s + 4
    end
    local roadDir = flatDir(pathPointAt(path, sNow + 3) - here, fwd)
    local safe = AutoDrive.C.maxSpeed or CONFIG.CRUISE_SPEED_MPS
    local aim = math.clamp(6.5 + speed * 0.20 - lat * 0.30, 5.0, 22)
    local target = pathPointAt(path, sNow + aim)
    local want = flatDir(target - pos, roadDir)
    local cosErr = fwd:Dot(want)
    local rel = cf:VectorToObjectSpace(want)
    local yawRate = phys.w and phys.w.Y or 0
    local steer
    if cosErr < 0.2 then
        steer = rel.X > 0 and -1 or 1
    else
        steer = math.clamp(-rel.X * 2.0 - yawRate * 0.11, -1, 1)
        if math.abs(steer) < 0.015 then steer = 0 end
    end
    local throttle = car:GetAttribute("AutoThrottle") or phys.throttle or 0
    local brake = car:GetAttribute("AutoBrake") or phys.brake or 0
    if speed > safe + 1.5 then
        throttle, brake = 0, math.clamp((speed - safe) / 8, 0.35, 1)
    elseif speed < safe - 1 and brake == 0 then
        throttle = 1
    end
    car:SetAttribute("AutoSteer", steer)
    car:SetAttribute("AutoThrottle", throttle)
    car:SetAttribute("AutoBrake", brake)
    phys.steerIn = steer
    phys.aiSteer = (math.abs(rel.X) > 0.06 or lat > 2.5 or minCos < 0.94)
    phys.gripScale = 3.0
    if speed > 2 and cosErr > 0.25 then
        local k = 0.22
        if lat > 2.0 then
            k = math.clamp(0.28 + (lat - 2.0) * 0.09, 0.28, 0.75)
        elseif math.abs(rel.X) > 0.10 then
            k = 0.34
        end
        local newV = vFlat:Lerp(want * speed, k)
        if newV.Magnitude > 0.01 then newV = newV.Unit * speed end
        phys.v = Vector3.new(newV.X, v.Y, newV.Z)
    end
end

