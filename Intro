local function driveToNpcSmooth(timeout)
if not isRunning or not _G.AutoQuestRunning then return false end
timeout = timeout or 90
stopNpcPositionHold()
local npcPos = getNpcPos()
local carPos = getCarState()
if not carPos then return false end

if (carPos - npcPos).Magnitude <= 7.0 then return true end

applyAutoDriveParams(true)
AutoDrive.request(npcPos, { snap = false, stopNavOnCancel = false })
AutoDrive.start()

local startTime = os.clock()
while isRunning and _G.AutoQuestRunning do
    task.wait(0.05)
    local curPos = getCarState()
    if not curPos then break end
    local dist = (curPos - getNpcPos()).Magnitude

    if dist <= 6.5 then
        pcall(function() AutoDrive.stop("reached_npc") end)
        return true
    end

    if os.clock() - startTime > timeout then break end
end
return false


end

