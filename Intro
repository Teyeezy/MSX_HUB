local function parseVector3(val)
    if typeof(val) == "Vector3" then return val end
    if type(val) ~= "string" then return nil end
    local x, y, z = string.match(val, "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
    return (x and y and z) and Vector3.new(tonumber(x), tonumber(y), tonumber(z)) or nil
end

-- Turbo Auto Boost[cite: 5]
local cachedBoostFn = nil
local function getBoostFn()
    if cachedBoostFn then return cachedBoostFn end
    for _, fn in ipairs(getgc(false)) do
        if type(fn) == "function" and not isexecutorclosure(fn) then
            local src, line = debug.info(fn, "sl")
            if src and string.find(src, "RCDriveClient") then
                local ok, consts = pcall(debug.getconstants, fn)
                if ok and consts then
                    for _, c in ipairs(consts) do
                        if c == "startBoost" or c == "boostTransition" then
                            cachedBoostFn = fn
                            return cachedBoostFn
                        end
                    end
                end
            end
        end
    end
    return nil
end

local lastBoostCmdAt = 0
local function tryAutoBoost()
    if not CONFIG.ENABLE_AUTO_BOOST then return end
    if os.clock() - lastBoostCmdAt < 0.25 then return end
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    local phys = rcd and rcd.phys
    if not phys or phys.boosting or phys.throttle <= 0 then return end

    local spState = EconomyRules.lastSPState
    if spState and spState.sp and spState.sp >= math.max(phys.p and phys.p.btNeedSP or 50, 20) then
        lastBoostCmdAt = os.clock()
        local myCar = workspace:FindFirstChild("MyCar")
        if myCar then pcall(function() myCar:SetAttribute("AutoCmd", "boost") end) end
        local boostFn = getBoostFn()
        if boostFn then pcall(boostFn) end
    end
end

-- Cornering Grip Assist (ลอจิกการเลี้ยวและเกาะถนนแบบไฟล์ต้นฉบับ)[cite: 5]
local adState = nil
pcall(function()
    if debug and debug.getupvalue and type(AutoDrive.debugState) == "function" then
        local st = debug.getupvalue(AutoDrive.debugState, 1)
        if type(st) == "table" then adState = st end
    end
end)

local function pathPointAt(path, s)
    local pts, cum, n = path.pts, path.cum, path.n
    if s <= 0 then return pts[1] end
    if s >= path.len then return pts[n] end
    local lo, hi = 1, n
    while hi - lo > 1 do
        local mid = (lo + hi) // 2
        if cum[mid] <= s then lo = mid else hi = mid end
    end
    local seg = cum[hi] - cum[lo]
    return pts[lo]:Lerp(pts[hi], seg > 0 and (s - cum[lo]) / seg or 0)
end

local function pathProject(path, pos, hint)
    local pts, cum, n = path.pts, path.cum, path.n
    local i0 = hint and math.max(1, hint - 3) or 1
    local i1 = hint and math.min(n - 1, hint + 35) or (n - 1)
    local px, pz = pos.X, pos.Z
    local bestD, bestS, bestIdx = math.huge, 0, i0
    for i = i0, i1 do
        local a, b = pts[i], pts[i + 1]
        local dx, dz = b.X - a.X, b.Z - a.Z
        local l2 = dx * dx + dz * dz
        local t = l2 > 1e-8 and math.clamp(((px - a.X) * dx + (pz - a.Z) * dz) / l2, 0, 1) or 0
        local cx, cz = a.X + dx * t - px, a.Z + dz * t - pz
        local d = cx * cx + cz * cz
        if d < bestD then bestD = d; bestS = cum[i] + (cum[i + 1] - cum[i]) * t; bestIdx = i end
    end
    return bestS, math.sqrt(bestD), bestIdx
end

local function flatDir(v, fallback)
    local m = math.sqrt(v.X * v.X + v.Z * v.Z)
    if m > 1e-4 then return Vector3.new(v.X / m, 0, v.Z / m) end
    return fallback
end

local function applyCorneringGripAssist()
    if not CONFIG.ENABLE_CORNERING_ASSIST then return end
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    local phys = rcd and rcd.phys
    if not phys or not phys.v or not adState or not adState.active or adState.near then return end

    local path = adState.path
    if not path or not path.n or path.n < 2 or not path.len then return end
    local root = getCarRoot()
    if not root then return end

    local cf = root.CFrame
    local pos = cf.Position
    local fwd = flatDir(cf.LookVector, Vector3.new(0, 0, -1))
    local vFlat = Vector3.new(phys.v.X, 0, phys.v.Z)
    local speed = vFlat.Magnitude

    local sNow, lat, segIdx = pathProject(path, pos, adState.pathHint)
    adState.pathHint = segIdx
    local aim = math.clamp(6.5 + speed * 0.20 - lat * 0.30, 5.0, 22)
    local target = pathPointAt(path, sNow + aim)
    local roadDir = flatDir(pathPointAt(path, sNow + 3) - pathPointAt(path, sNow), fwd)
    local want = flatDir(target - pos, roadDir)
    local rel = cf:VectorToObjectSpace(want)

    phys.steerIn = math.clamp(-rel.X * 2.0, -1, 1)
    phys.gripScale = 2.8
end

RunService.Heartbeat:Connect(function()
    if isRunning and _G.AutoQuestRunning then
        pcall(applyCorneringGripAssist)
    end
end)

-- Unstuck & Smooth Drive to NPC[cite: 5]
local function performUnstuck(targetPos)
    pcall(function() AutoDrive.stop("unstuck") end)
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    if rcd and rcd.phys then
        rcd.phys.throttle = -0.65
        rcd.phys.steerIn = 0.55
        task.wait(0.8)
        rcd.phys.throttle = 0
        rcd.phys.steerIn = 0
    end
    if targetPos then
        applyAutoDriveParams(false)
        AutoDrive.request(targetPos, { snap = false, stopNavOnCancel = false })
        AutoDrive.start()
    end
end

local function driveToNpcSmooth(timeout)
    if not isRunning or not _G.AutoQuestRunning then return false end
    timeout = timeout or 90
    local npcPos = getNpcPos()
    local carPos = getCarState()
    if not carPos then return false end

    if (carPos - npcPos).Magnitude <= 6.5 then return true end

    applyAutoDriveParams(true)
    AutoDrive.request(npcPos, { snap = false, stopNavOnCancel = false })
    AutoDrive.start()

    local startTime = os.clock()
    local lastPos = carPos
    local lastMoveT = os.clock()

    while isRunning and _G.AutoQuestRunning do
        task.wait(0.05)
        maintainHooks()
        local currentPos = getCarState()
        if not currentPos then break end

        npcPos = getNpcPos()
        local dist = (currentPos - npcPos).Magnitude
        if dist <= 6.5 then
            pcall(function() AutoDrive.stop("reached_npc") end)
            return true
        end

        if (currentPos - lastPos).Magnitude > 2 then
            lastPos = currentPos
            lastMoveT = os.clock()
        elseif os.clock() - lastMoveT > CONFIG.STUCK_TIME_SEC and dist > 8 then
            performUnstuck(npcPos)
            lastPos = getCarState() or currentPos
            lastMoveT = os.clock()
        end

        if os.clock() - startTime > timeout then break end
    end
    return false
end

local function ensureQuestAccepted()
    local st = getQuestState()
    if st and (st.state == "running" or st.state == "boarding") and st.questId == CONFIG.QUEST_ID then
        return true
    end

    print(string.format("[AutoQuest] กำลังเดินทางไปรับเควส Min R Lv.20 (%s)...", CONFIG.QUEST_ID))

    for attempt = 1, CONFIG.MAX_ACCEPT_RETRIES do
        if not isRunning or not _G.AutoQuestRunning then return false end

        st = getQuestState()
        if st and (st.state == "running" or st.state == "boarding") and st.questId == CONFIG.QUEST_ID then
            return true
        end

        local carPos = getCarState()
        local npcPos = getNpcPos()
        if not carPos or (carPos - npcPos).Magnitude > 6.5 then
            driveToNpcSmooth(60)
            task.wait(0.2)
            carPos = getCarState()
        end

        if QuestRequest and carPos then
            pcall(function() QuestRequest:InvokeServer({op = "talk", npcId = CONFIG.NPC_ID, carPos = carPos}) end)
            task.wait(0.08)
            pcall(function() QuestRequest:InvokeServer({op = "accept", questId = CONFIG.QUEST_ID, npcId = CONFIG.NPC_ID, carPos = carPos}) end)
            task.wait(0.08)
            pcall(function() QuestRequest:InvokeServer({op = "boarded", questId = CONFIG.QUEST_ID, carPos = carPos}) end)
        end

        local rq = (getrenv and getrenv().shared.RBRCQuest) or shared.RBRCQuest
        if rq and rq.talk then pcall(rq.talk, CONFIG.NPC_ID) end

        for waitStep = 1, 20 do
            task.wait(0.1)
            st = getQuestState()
            if st and st.questId == CONFIG.QUEST_ID and (st.state == "running" or st.state == "boarding") then
                print("[AutoQuest] รับเควส Min R สำเร็จแล้ว!")
                return true
            end
        end
        task.wait(0.3)
    end
    return false
end

local function getActiveObjective(st)
    if not st or (st.state ~= "running" and st.state ~= "boarding") then return nil end
    local q = st.q
    if q and q.objectives then
        for _, obj in ipairs(q.objectives) do
            if obj.dest and obj.dest.target and not obj.passive then
                local objState = st.objectives and st.objectives[obj.idx]
                if not (objState and objState.done) and (obj.step == st.step or st.step == 0) then
                    local targetPos = parseVector3(obj.dest.target)
                    if targetPos then
                        return {
                            idx = obj.idx,
                            step = obj.step or st.step,
                            target = targetPos,
                            isStop = (obj.dest.stop == true) or (obj.dest.pillar == "stop"),
                            poly = obj.dest.poly
                        }
                    end
                end
            end
        end
    end
    return nil
end

-- ฟังก์ชันรันลูปเควสรอบหลัก พร้อมระบบชะลอความเร็วนุ่มนวลเมื่อถึงจุด STOP (ตามไฟล์ต้นฉบับ)[cite: 5]
local function runOneQuestCycle()
    local accepted = ensureQuestAccepted()
    if not accepted then task.wait(1.0); return end

    print(string.format("[AutoQuest] เริ่มต้นนำทางเส้นทางเควส Min R (%s)!", CONFIG.QUEST_ID))
    AutoDrive.C.maxSpeed = CONFIG.CRUISE_SPEED_MPS

    local currentActiveIdx = nil
    local currentActiveTarget = nil
    local currentActiveIsStop = false
    local isHoldingStopBox = false
    local questStateUnknownSince = nil

    while isRunning and _G.AutoQuestRunning do
        task.wait(0.06)
        tryAutoBoost()
        maintainHooks()

        if CONFIG.ENABLE_AUTO_THRILL then
            pcall(function()
                local rq = (getrenv and getrenv().shared.RBRCQuest) or shared.RBRCQuest
                if rq and rq.reportThrill then rq.reportThrill(2) end
            end)
        end

        local st = getQuestState()
        if not st then
            questStateUnknownSince = questStateUnknownSince or os.clock()
            if os.clock() - questStateUnknownSince >= CONFIG.QUEST_STATE_UNKNOWN_TIMEOUT then
                break
            end
            task.wait(0.2)
            continue
        end
        questStateUnknownSince = nil

        if st.state ~= "running" and st.state ~= "boarding" then break end

        local activeObj = getActiveObjective(st)
        if not activeObj then task.wait(0.1); continue end

        if activeObj.idx ~= currentActiveIdx or currentActiveTarget == nil or (activeObj.target - currentActiveTarget).Magnitude > 2 then
            currentActiveIdx = activeObj.idx
            currentActiveTarget = activeObj.target
            currentActiveIsStop = activeObj.isStop
            isHoldingStopBox = false

            applyAutoDriveParams(activeObj.isStop)
            AutoDrive.request(activeObj.target, { snap = not activeObj.isStop, stopNavOnCancel = false })
            AutoDrive.start()
        end

        local carPosNow = getCarState()
        local distToTarget = carPosNow and (carPosNow - activeObj.target).Magnitude or 999
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        local speedKmh = rcd and rcd.phys and rcd.phys.v and (rcd.phys.v.Magnitude * 3.6) or 0

        -- ลอจิกชะลอความเร็วนุ่มนวลเมื่อใกล้จุด STOP ตามไฟล์ต้นฉบับ[cite: 5]
        if activeObj.isStop and not isHoldingStopBox and carPosNow then
            if distToTarget <= 50 then
                local targetSpeedKmh = distToTarget > 25 and 30 or (distToTarget > 10 and 18 or 8)
                AutoDrive.C.maxSpeed = targetSpeedKmh / 3.6
                if speedKmh > targetSpeedKmh + 2 then
                    rcd.phys.throttle = 0
                    rcd.phys.brake = 0.5
                end
            end
            if distToTarget <= 4.0 then
                isHoldingStopBox = true
                pcall(function() AutoDrive.stop("stopped_at_destination") end)
            end
        end

        if isHoldingStopBox then
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
            end
            task.wait(0.1)
            continue
        end

        if isAutoDriveActive() == false then
            AutoDrive.request(activeObj.target, { snap = not activeObj.isStop, stopNavOnCancel = false })
            AutoDrive.start()
        end
    end

    AutoDrive.stop("cycle_done")
    task.wait(CONFIG.LOOP_DELAY)
end

