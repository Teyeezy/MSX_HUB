        renvShared.RCDrivePairHooks.traffic = dummyHook
        renvShared.RCDrivePairHooks.mov = dummyHook
    end
    if shared.RCDrivePairHooks then
        shared.RCDrivePairHooks.traffic = dummyHook
        shared.RCDrivePairHooks.mov = dummyHook
    end
    if renvShared and renvShared.RBRCQuest then renvShared.RBRCQuest.reportCollision = dummyHook end
    if shared.RBRCQuest then shared.RBRCQuest.reportCollision = dummyHook end
    workspace:SetAttribute("RaycityWallGuardOff", true)
    workspace:SetAttribute("RCWallMapData", false)
    workspace:SetAttribute("RCNativeWorldHit", false)
    local rwg = shared.RaycityWallGuard
    if rwg then
        if rwg.dataHit ~= dummyHookFalse then rwg.dataHit = dummyHookFalse end
        if rwg.wallAt ~= dummyHook then rwg.wallAt = dummyHook end
        if rwg.solid ~= dummyHookFalse then rwg.solid = dummyHookFalse end
    end
    if os.clock() - lastNoclipSweep > 1.0 then
        lastNoclipSweep = os.clock()
        pcall(function()
            local tf = workspace:FindFirstChild("RBRCTrafficCars")
            if tf then
                for _, part in ipairs(tf:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
                end
            end
        end)
    end
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    if rcd and rcd.phys then
        local phys = rcd.phys
        if phys.throttle > 0 and phys.gear == 0 then phys.gear = 1
        elseif phys.throttle < 0 and phys.gear == 0 then phys.gear = -1 end
        if phys.p then
            phys.p.redRpm = math.max(phys.p.redRpm or 6000, 9800)
            phys.p.maxRpm = math.max(phys.p.maxRpm or 7830, 11500)
            phys.p.vmax = math.max(phys.p.vmax or 100, 135)
            phys.p.btPower = math.max(phys.p.btPower or 2.5, 4.2)
            phys.p.btOver = math.max(phys.p.btOver or 1.12, 1.45)
        end
        phys.torqueBonus = math.max(phys.torqueBonus or 0, 750)
        phys.gripScale = math.max(phys.gripScale or 1, 3.0)
    end
end

