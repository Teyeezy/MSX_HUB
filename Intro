local LocalPlayer = Players.LocalPlayer

_G.AutoFarm = false
_G.FarmSpeed = 74
local running = false

local CFG = {
    AcceptMaxTry = 8,
    StuckSec = 4.2,
    ChkTimeout = 85,
    MinLoopWait = 2.8,
    MaxLoopWait = 6.5,
    SpeedJitter = 9,
    ThinkMin = 0.35,
    ThinkMax = 1.4,
}

local P1 = {
    id = "R1676",
    npc = "roadfight:1676",
    name = "Npc_931676",
    pos = Vector3.new(-1225.35, 40.34, -5316.00),
    road = true,
    slot = 1,
    maxLv = 17,
}

local P2 = {
    id = "S105",
    npc = "mission24:105",
    name = "Npc_940105",
    pos = Vector3.new(2585.60, 56.60, -2067.60),
    road = false,
    maxLv = 99,
}

local phase = P1

local RBRCQuest = ReplicatedStorage:WaitForChild("RBRCQuest", 20)
local Remotes = RBRCQuest:WaitForChild("Remotes", 15)
local QuestRequest = Remotes:WaitForChild("QuestRequest", 10)
local RoadFightRequest = Remotes:FindFirstChild("RoadFightRequest")

local RaycityUi = ReplicatedStorage:WaitForChild("RaycityUi", 20)
local AutoDrive = require(RaycityUi:WaitForChild("AutoDrive", 15))

local function rng(a, b)
    return a + math.random() * (b - a)
end

local function waitHuman(a, b)
    task.wait(rng(a, b))
end

local function getLv()
    local ok, v = pcall(function()
        local p = shared.RaycityShop and shared.RaycityShop.profile and shared.RaycityShop.profile.get()
        return p and tonumber(p.level) or 1
    end)
    return ok and v or 1
end

local function carRoot()
    local c = workspace:FindFirstChild("MyCar")
    if not c then return nil end
    if c:IsA("BasePart") then return c end
    return c.PrimaryPart or c:FindFirstChild("Root") or c:FindFirstChildWhichIsA("BasePart")
end

local function carPos()
    local r = carRoot()
    return r and r.Position
end

local function questState()
    local rq = shared.RBRCQuest
    if rq and type(rq.state) == "function" then
        local ok, st = pcall(rq.state)
        if ok and type(st) == "table" then return st end
    end
    return nil
end

local function setSpeed(base)
    local jitter = rng(-CFG.SpeedJitter, CFG.SpeedJitter)
    local spd = math.clamp((base or _G.FarmSpeed) + jitter, 48, 92)
    AutoDrive.C.maxSpeed = spd
    AutoDrive.C.nearDestM = 1.6
    AutoDrive.C.arriveNearM = 2.6
    AutoDrive.options.arriveBrake = false
    AutoDrive.options.evasions = false
    AutoDrive.options.aiDrift = false
    AutoDrive.options.uturnSweep = false
    AutoDrive.canCruise = function() return true end
    return spd
end

local function stopAD()
    pcall(function() AutoDrive.stop("ok") end)
end

local function goTo(target, timeout)
    timeout = timeout or 95
    setSpeed()
    local ok = AutoDrive.request(target, {snap = false, stopNavOnCancel = false})
    if not ok then return false end
    AutoDrive.start()

    local t0 = os.clock()
    local last = carPos()
    local lastMove = os.clock()

    while running and _G.AutoFarm do
        task.wait(0.11)
        local now = carPos()
        if not now then break end

        local d = (now - target).Magnitude
        if d <= 7.5 then
            stopAD()
            local rcd = shared.RCDrive
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.v = Vector3.zero
            end
            waitHuman(0.25, 0.55)
            return true
        end

        if last and (now - last).Magnitude > 2 then
            last = now
            lastMove = os.clock()
        elseif d > 14 and os.clock() - lastMove > CFG.StuckSec then
            local rcd = shared.RCDrive
            if rcd and rcd.phys then
                rcd.phys.throttle = -0.45
                rcd.phys.brake = 0
            end
            waitHuman(0.6, 1.0)
            AutoDrive.request(target, {snap = false})
            AutoDrive.start()
            lastMove = os.clock()
        end

        if os.clock() - t0 > timeout then
            stopAD()
            return false
        end

        if AutoDrive.isActive and not AutoDrive.isActive() then
            AutoDrive.request(target, {snap = false})
            AutoDrive.start()
        end
    end
    return false
end

local function accept()
    for try = 1, CFG.AcceptMaxTry do
        if not running or not _G.AutoFarm then return false end

        local st = questState()
        if st and st.questId == phase.id and (st.state == "running" or st.state == "boarding") then
            return true
        end

        local pos = carPos()
        if not pos then
            waitHuman(0.4, 0.8)
            continue
        end

        local dist = (pos - phase.pos).Magnitude
        if dist > 9 then
            if not goTo(phase.pos, 90) then
                waitHuman(0.6, 1.2)
                continue
            end
            pos = carPos()
        end

        waitHuman(CFG.ThinkMin, CFG.ThinkMax)

        pcall(function()
            if phase.road then
                QuestRequest:InvokeServer({op = "talk", npcId = phase.npc, carPos = pos})
                waitHuman(0.18, 0.35)
                if RoadFightRequest then
                    RoadFightRequest:InvokeServer({op = "accept", npcId = phase.npc, slot = phase.slot or 1})
                end
            else
                QuestRequest:InvokeServer({op = "talk", npcId = phase.npc, carPos = pos})
                waitHuman(0.15, 0.28)
                QuestRequest:InvokeServer({op = "accept", questId = phase.id, npcId = phase.npc, carPos = pos})
                waitHuman(0.12, 0.25)
                QuestRequest:InvokeServer({op = "boarded", questId = phase.id, carPos = pos})
            end
        end)

        for _ = 1, 22 do
            waitHuman(0.09, 0.16)
            st = questState()
            if st and st.questId == phase.id then
                if st.state == "running" then return true end
                if st.state == "boarding" then
                    pcall(function()
                        QuestRequest:InvokeServer({op = "boarded", questId = phase.id})
                    end)
                end
            end
        end
        waitHuman(0.5, 1.1)
    end
    return false
end

local function activeObj(st)
    if not st or not st.objectives then return nil end
    for i, o in ipairs(st.objectives) do
        if o and not o.done then
            local t = o.pos or o.target or o.point
            if typeof(t) == "Vector3" then
                return {
                    i = i,
                    t = t,
                    stop = (o.type == "stop" or o.kind == "stop" or (o.flags and o.flags.stop)),
                }
            end
        end
    end
    return nil
end

local function cycle()
    local lv = getLv()
    phase = (lv < P1.maxLv) and P1 or P2

    if not accept() then
        waitHuman(1.8, 3.2)
        return
    end

    local curT, isStop = nil, false
    local stepT = os.clock()
    local lastP = carPos()
    local lastM = os.clock()

    while running and _G.AutoFarm do
        task.wait(0.12)

        local st = questState()
        if not st or (st.state ~= "running" and st.state ~= "boarding") then
            break
        end

        local act = activeObj(st)
        if not act then
            task.wait(0.15)
            continue
        end

        if not curT or (act.t - curT).Magnitude > 4 then
            curT = act.t
            isStop = act.stop
            stepT = os.clock()
            setSpeed()
            AutoDrive.request(curT, {snap = not isStop, stopNavOnCancel = false})
            AutoDrive.start()
        end

        local pos = carPos()
        if not pos then break end
        local d = (pos - curT).Magnitude
        local rcd = shared.RCDrive
        local spd = rcd and rcd.phys and rcd.phys.v and rcd.phys.v.Magnitude * 3.6 or 0

        if isStop and d < 45 then
            AutoDrive.C.maxSpeed = math.clamp(d * 0.55, 3.5, _G.FarmSpeed * 0.35)
        end

        if isStop and d <= 5.5 then
            stopAD()
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.v = Vector3.zero
            end
            waitHuman(0.4, 0.9)
            break
        end

        if lastP and (pos - lastP).Magnitude > 2.2 or spd > 6 then
            lastP = pos
            lastM = os.clock()
        elseif d > 15 and os.clock() - lastM > CFG.StuckSec then
            if rcd and rcd.phys then
                rcd.phys.throttle = -0.4
            end
            waitHuman(0.55, 0.95)
            AutoDrive.request(curT, {snap = false})
            AutoDrive.start()
            lastM = os.clock()
        end

        if os.clock() - stepT > CFG.ChkTimeout then
            AutoDrive.request(curT, {snap = false})
            AutoDrive.start()
            stepT = os.clock()
        end
    end

    stopAD()
    waitHuman(CFG.MinLoopWait, CFG.MaxLoopWait)
end

