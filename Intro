local function maintainHooks()
    local renvShared = (getrenv and getrenv().shared) or shared
    if renvShared and renvShared.RCDrivePairHooks then
        renvShared.RCDrivePairHooks.traffic = dummyHook
        renvShared.RCDrivePairHooks.mov = dummyHook
