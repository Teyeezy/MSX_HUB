local function claimAllDropsAndSellInventory()
    if not CONFIG.ENABLE_AUTO_LOOT and not CONFIG.ENABLE_AUTO_SELL then return end
    pcall(function()
        if CONFIG.ENABLE_AUTO_LOOT and type(cachedDropTbl) == "table" then
            for dropId, entry in pairs(cachedDropTbl) do
                if type(entry) == "table" and type(cachedDropGetAllFn) == "function" then
                    pcall(cachedDropGetAllFn, entry)
                end
                if MXRequest then
                    pcall(function() MXRequest:InvokeServer("pick", { id = dropId }) end)
                end
            end
        end
        if CONFIG.ENABLE_AUTO_SELL then
            local rs = (getrenv and getrenv().shared.RaycityShop) or shared.RaycityShop
            if rs and type(rs.request) == "function" then
                local prof = rs.profile and rs.profile.get and rs.profile.get()
                local inv = prof and prof.inventory
                if type(inv) == "table" then
                    for slotIdx = 1, (tonumber(prof.invSize) or 30) do
                        local item = inv[tostring(slotIdx)] or inv[slotIdx]
                        if type(item) == "table" and item.uid and (CONFIG.SELL_BOUND_ITEMS or not item.bound) then
                            rs.request("sell", { cell = slotIdx, count = tonumber(item.count) or 1, uid = item.uid })
                        end
                    end
                end
            end
        end
    end)
end

local function ensureQuestAccepted(phaseCfg)
    applyPhaseConfig(phaseCfg)
    claimAllDropsAndSellInventory()
    if isRefuelNeeded(true) then ensureFuelReady(true) end

    local st = getQuestState()
    if st and (st.state == "running" or st.state == "boarding") and st.questId == phaseCfg.QUEST_ID then
        stopNpcPositionHold()
        return true
    end

    for attempt = 1, CONFIG.MAX_ACCEPT_RETRIES do
        if not isRunning or not _G.AutoQuestRunning then stopNpcPositionHold() return false end
        st = getQuestState()
        if st and (st.state == "running" or st.state == "boarding") and st.questId == phaseCfg.QUEST_ID then
            stopNpcPositionHold()
            return true
        end

        local carPos = getCarState()
        if not carPos then task.wait(0.3) continue end
        local npcPos = getNpcPos()
        if (carPos - npcPos).Magnitude > 7.0 then
            driveToNpcSmooth(90)
        end

        startNpcPositionHold()
        local QuestUI = require(ReplicatedStorage.RBRCQuest.QuestUI)

        if phaseCfg.IS_ROADFIGHT then
            if QuestRequest then pcall(function() QuestRequest:InvokeServer({op = "talk", npcId = phaseCfg.NPC_ID, carPos = carPos}) end) end
            task.wait(0.15)
            if QuestUI and QuestUI.offerShown and QuestUI.offerShown() then pcall(function() QuestUI._offerAnswer(true) end) end
            if RoadFightRequest then pcall(function() RoadFightRequest:InvokeServer({op = "accept", npcId = phaseCfg.NPC_ID, slot = phaseCfg.SLOT or 1}) end) end
        else
            if QuestRequest then
                pcall(function() QuestRequest:InvokeServer({op = "talk", npcId = phaseCfg.NPC_ID, carPos = carPos}) end)
                task.wait(0.08)
                pcall(function() QuestRequest:InvokeServer({op = "accept", questId = phaseCfg.QUEST_ID, npcId = phaseCfg.NPC_ID, carPos = carPos}) end)
                task.wait(0.08)
                pcall(function() QuestRequest:InvokeServer({op = "boarded", questId = phaseCfg.QUEST_ID, carPos = carPos}) end)
            end
            if QuestUI and QuestUI.offerShown and QuestUI.offerShown() then pcall(function() QuestUI._offerAnswer(true) end) end
        end

        for _ = 1, 30 do
            task.wait(0.1)
            st = getQuestState()
            if st and st.questId == phaseCfg.QUEST_ID and st.state == "running" then
                stopNpcPositionHold()
                return true
            end
        end
    end
    stopNpcPositionHold()
    return false
end

local function runOneQuestCycle()
    local currentLv = getPlayerLevel()
    local phaseCfg = (currentLv < CONFIG.PHASE1_MAX_LEVEL) and CONFIG.PHASE1 or CONFIG.PHASE2
    applyPhaseConfig(phaseCfg)

    if not ensureQuestAccepted(phaseCfg) then
        task.wait(2.0)
        return
    end

    AutoDrive.C.maxSpeed = phaseCfg.CRUISE_SPEED_MPS
    local currentActiveIdx, currentActiveTarget, currentActiveIsStop, currentActivePoly = nil, nil, false, nil
    local stepStartTime = os.clock()
    local lastStuckT, lastStuckPos = os.clock(), getCarState()
    local lastProgressAt = os.clock()
    local bestDistanceToTarget = math.huge
    local lastThrillReportAt = 0

    while isRunning and _G.AutoQuestRunning do
        task.wait(0.06)
        tryAutoBoost()
        applyCorneringGripAssist()

        if CONFIG.ENABLE_AUTO_THRILL and (os.clock() - lastThrillReportAt) >= 1.5 then
            lastThrillReportAt = os.clock()
            pcall(function()
                local rq = (getrenv and getrenv().shared.RBRCQuest) or shared.RBRCQuest
                if rq and rq.reportThrill then rq.reportThrill(2) end
            end)
        end

        if isRefuelNeeded(false) then ensureFuelReady(false) end

        local st = getQuestState()
        if not st then
            if currentActiveIsStop and isCarInsidePoly(currentActivePoly, getCarState()) then break end
            task.wait(0.2)
            continue
        end

        if st.state ~= "running" and st.state ~= "boarding" then break end
        local activeObj = getActiveObjective(st)
        if not activeObj then task.wait(0.08) continue end

        local targetChanged = currentActiveTarget == nil or (activeObj.target - currentActiveTarget).Magnitude > 2 or activeObj.isStop ~= currentActiveIsStop
        if activeObj.idx ~= currentActiveIdx or targetChanged then
            currentActiveIdx = activeObj.idx
            currentActiveTarget = activeObj.target
            currentActiveIsStop = activeObj.isStop
            currentActivePoly = activeObj.poly
            stepStartTime = os.clock()
            lastStuckT = os.clock()
            lastStuckPos = getCarState()
            bestDistanceToTarget = lastStuckPos and (lastStuckPos - activeObj.target).Magnitude or math.huge
            lastProgressAt = os.clock()
            isHoldingStopBox = false

            applyAutoDriveParams(activeObj.isStop)
            AutoDrive.request(activeObj.target, { snap = not activeObj.isStop, stopNavOnCancel = false })
            AutoDrive.start()
        end

        local carPosNow = getCarState()
        local distToTarget = carPosNow and (carPosNow - activeObj.target).Magnitude or 999
        local inBox = activeObj.isStop and isCarInsidePoly(activeObj.poly, carPosNow)
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        local speedKmh = rcd and rcd.phys and rcd.phys.v and (rcd.phys.v.Magnitude * 3.6) or 0

        if activeObj.isStop and not isHoldingStopBox and ((inBox and distToTarget <= 6.0 and speedKmh < 3.0) or distToTarget <= 3.8) then
            isHoldingStopBox = true
            pcall(function() AutoDrive.stop("stopped") end)
        end

        if isHoldingStopBox then
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
                rcd.phys.v = Vector3.zero
                rcd.phys.w = Vector3.zero
            end
            task.wait(0.08)
            continue
        end

        if carPosNow then
            if (carPosNow - (lastStuckPos or carPosNow)).Magnitude > 3.0 or speedKmh > 5 then
                lastStuckPos = carPosNow
                lastStuckT = os.clock()
            elseif (not activeObj.isStop and distToTarget > 12) or (activeObj.isStop and distToTarget > 35) then
                if (os.clock() - lastStuckT) > (activeObj.isStop and 4.0 or CONFIG.STUCK_TIME_SEC) then
                    performUnstuck(activeObj.target)
                    lastStuckPos = getCarState() or carPosNow
                    lastStuckT = os.clock()
                end
            end
        end
    end

    AutoDrive.stop("quest_done")
    task.wait(0.35)
    claimAllDropsAndSellInventory()
    task.wait(CONFIG.LOOP_DELAY)
end

