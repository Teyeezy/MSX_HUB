            lastPos = curPos
            lastMoveT = os.clock()
        else
            local stillT = os.clock() - lastMoveT
            if distToStation > 8 and stillT > CONFIG.STUCK_TIME_SEC then
                performUnstuck(station.pos)
                lastPos = getCarState() or curPos
                lastMoveT = os.clock()
            end
        end

        if os.clock() - startTime > timeout then
            pcall(function() AutoDrive.stop("fuel_timeout") end)
            warn("[AutoQuest] ⛽ ขับไปปั๊มน้ำมันเกินเวลา Timeout!")
            break
        end
    end

    return false
end

local function ensureFuelReady(beforeQuest)
    if not CONFIG.ENABLE_AUTO_REFUEL then return true end
    if not isRefuelNeeded(beforeQuest) then return true end

    local f, c = getFuelInfo()
    print(string.format("[AutoQuest] ⛽ ตรวจพบลำดับการเติมน้ำมัน (น้ำมันเหลือ: %.1f / %.1f L) กำลังขับไปปั๊ม...", f or 0, c or 0))

    local ok = driveToFuelAndRefuel(120)
    if ok then
        task.wait(0.3)
        return true
    else
        warn("[AutoQuest] ⛽ ไม่สามารถเติมน้ำมันได้สำเร็จ จะดำเนินการต่อด้วยความระมัดระวัง")
        return false
    end
end

