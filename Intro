local function pathPointAt(path, s)
    local pts, cum, n = path.pts, path.cum, path.n
    if s <= 0 then return pts[1] end
    if s >= path.len then return pts[n] end
    local lo, hi = 1, n
    while hi - lo > 1 do
        local mid = (lo + hi) // 2
        if cum[mid] <= s then lo = mid else hi = mid end
    end
    local seg = cum[hi] - cum[lo]
    return pts[lo]:Lerp(pts[hi], seg > 0 and (s - cum[lo]) / seg or 0)
end

local function sanitizePath(path)
    if not path or path._sanitized or not path.pts or not path.n or path.n < 4 then return end
    local pts, cum, n = path.pts, path.cum, path.n
    local newPts = {}
    local i = 1
    while i <= n do
        newPts[#newPts + 1] = pts[i]
        local jumpTo = nil
        local maxJ = math.min(n - 1, i + 12)
        for j = maxJ, i + 2, -1 do
            local pathDist = cum[j] - cum[i]
            if pathDist > 20 then
                local dx, dz = pts[j].X - pts[i].X, pts[j].Z - pts[i].Z
                local directDist = math.sqrt(dx * dx + dz * dz) / 2
                if directDist < 16 and pathDist > directDist * 3 then
                    jumpTo = j
                    break
                end
            end
        end
        if jumpTo then i = jumpTo + 1 else i = i + 1 end
    end
    if #newPts < n and #newPts >= 2 then
        local newCum = {0}
        local total = 0
        for k = 2, #newPts do
            total = total + (newPts[k] - newPts[k - 1]).Magnitude / 2
            newCum[k] = total
        end
        path.pts = newPts
        path.cum = newCum
        path.n = #newPts
        path.len = total
        if adState then adState.pathHint = 1 end
    end
    path._sanitized = true
end

local function pathProject(path, pos, hint)
    local pts, cum, n = path.pts, path.cum, path.n
    local i0 = hint and math.max(1, hint - 3) or 1
    local i1 = hint and math.min(n - 1, hint + 35) or (n - 1)
    local px, pz = pos.X, pos.Z
    local bestD, bestS, bestIdx = math.huge, 0, i0
    for i = i0, i1 do
        local a, b = pts[i], pts[i + 1]
        local dx, dz = b.X - a.X, b.Z - a.Z
        local l2 = dx * dx + dz * dz
        local t = l2 > 1e-8 and math.clamp(((px - a.X) * dx + (pz - a.Z) * dz) / l2, 0, 1) or 0
        local cx, cz = a.X + dx * t - px, a.Z + dz * t - pz
        local d = cx * cx + cz * cz
        if d < bestD then
            bestD = d
            bestS = cum[i] + (cum[i + 1] - cum[i]) * t
            bestIdx = i
        end
    end
    return bestS, math.sqrt(bestD), bestIdx
end

local function flatDir(v, fallback)
    local m = math.sqrt(v.X * v.X + v.Z * v.Z)
    if m > 1e-4 then return Vector3.new(v.X / m, 0, v.Z / m) end
    return fallback
end

