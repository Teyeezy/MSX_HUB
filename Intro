local function isCarInsidePoly(polyRaw, carPos)
    if type(polyRaw) ~= "table" or not carPos then return false end
    local polyFlat = {}
    for _, p in ipairs(polyRaw) do
        local x, z
        if typeof(p) == "Vector3" then x, z = p.X, p.Z
        elseif type(p) == "table" then x, z = tonumber(p.X or p.x or p[1]), tonumber(p.Z or p.z or p[3] or p[2])
        elseif type(p) == "string" then
            local sx, _, sz = string.match(p, "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
            x, z = tonumber(sx), tonumber(sz)
        end
        if x and z then table.insert(polyFlat, x) table.insert(polyFlat, z) end
    end
    if #polyFlat < 6 or #polyFlat % 2 ~= 0 then return false end
    if MatchGeom and type(MatchGeom.inside) == "function" then
        local ok, result = pcall(MatchGeom.inside, polyFlat, carPos.X, carPos.Z)
        if ok and type(result) == "boolean" then return result end
    end
    local inside = false
    local j = #polyFlat - 1
    for i = 1, #polyFlat, 2 do
        local xi, zi = polyFlat[i], polyFlat[i + 1]
        local xj, zj = polyFlat[j], polyFlat[j + 1]
        local crosses = ((zi > carPos.Z) ~= (zj > carPos.Z)) and (carPos.X < (xj - xi) * (carPos.Z - zi) / ((zj - zi) ~= 0 and (zj - zi) or 1e-9) + xi)
        if crosses then inside = not inside end
        j = i
    end
    return inside
end

