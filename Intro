local function getActiveObjective(st)
    if not st or (st.state ~= "running" and st.state ~= "boarding") then return nil end
    local q = st.q
    local currentObj = nil
    if q and q.objectives then
        for _, obj in ipairs(q.objectives) do
            if obj.dest and obj.dest.target and not obj.passive then
                local objState = st.objectives and st.objectives[obj.idx]
                local isDone = objState and (objState.done == true)
                if not isDone and (obj.step == st.step or st.step == 0) then
                    currentObj = obj
                    break
                end
            end
        end
    end
    if currentObj then
        local targetPos = parseVector3(currentObj.dest.target)
        if targetPos then
            local isStop = (currentObj.dest.stop == true) or (currentObj.dest.pillar == "stop")
            return {
                idx = currentObj.idx, step = currentObj.step or st.step,
                target = targetPos, isStop = isStop,
                pillar = currentObj.dest.pillar, poly = currentObj.dest.poly
            }
        end
    end
    local nav = (getrenv and getrenv().shared.RaycityNavigation) or shared.RaycityNavigation
    if nav and nav.getGuide then
        local guide = nav.getGuide()
        if guide and (guide.target or guide.goal) then
            local gTarget = guide.target or guide.goal
            local parsedPos = parseVector3(gTarget)
            if parsedPos then
                return {
                    idx = guide.idx or st.step, step = st.step,
                    target = parsedPos, isStop = (guide.stop == true) or (guide.pillar == "stop"),
                    pillar = guide.pillar, poly = nil
                }
            end
        end
    end
    return nil
end

local unstuckDir = 1
local function performUnstuck(targetPos)
    pcall(function() AutoDrive.stop("unstuck") end)
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    if rcd and rcd.phys then
        local myCF = getCarRoot() and getCarRoot().CFrame
        local steer = 0.55
        if myCF and targetPos then
            local rel = myCF:PointToObjectSpace(targetPos)
            steer = (rel.X >= 0) and -0.55 or 0.55
        else
            unstuckDir = -unstuckDir
            steer = 0.55 * unstuckDir
        end
        rcd.phys.brake = 0
        rcd.phys.throttle = -0.65
        rcd.phys.steerIn = steer
        task.wait(0.7)
        rcd.phys.throttle = 0
        rcd.phys.steerIn = 0
        rcd.phys.brake = 1
        task.wait(0.12)
        rcd.phys.brake = 0
    end
    if targetPos and _G.AutoQuestRunning then
        applyAutoDriveParams(false)
        AutoDrive.request(targetPos, { snap = false, stopNavOnCancel = false })
        AutoDrive.start()
    end
end

local function driveToNpcSmooth(timeout)
    if not _G.AutoQuestRunning then return false end
    timeout = timeout or 90
    stopNpcPositionHold()
    local npcPos = getNpcPos()
    local carPos = getCarState()
    if not carPos then return false end
    local distToNpc = (carPos - npcPos).Magnitude
    if distToNpc <= 7.0 then
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if rcd and rcd.phys then
            rcd.phys.throttle = 0
            rcd.phys.brake = 1
            rcd.phys.steerIn = 0
            rcd.phys.v = Vector3.new(0, 0, 0)
        end
        return true
    end
    applyAutoDriveParams(true)
    AutoDrive.C.maxSpeed = (distToNpc > 65) and CONFIG.CRUISE_SPEED_MPS or 40.0
    local ok = AutoDrive.request(npcPos, { snap = false, stopNavOnCancel = false })
    if ok then AutoDrive.start() else return false end
    local startTime = os.clock()
    local lastPos = carPos
    local lastMoveT = os.clock()
    while _G.AutoQuestRunning do
        task.wait(0.04)
        applyCorneringGripAssist()
        maintainHooks()
        local currentPos = getCarState()
        if not currentPos then break end
        npcPos = getNpcPos()
        local curDistToNpc = (currentPos - npcPos).Magnitude
        if curDistToNpc > 65 then AutoDrive.C.maxSpeed = CONFIG.CRUISE_SPEED_MPS
        elseif curDistToNpc > 30 then AutoDrive.C.maxSpeed = 34.0
        elseif curDistToNpc > 14 then AutoDrive.C.maxSpeed = 15.0
        else AutoDrive.C.maxSpeed = 5.5 end
        if curDistToNpc <= 6.5 then
            pcall(function() AutoDrive.stop("reached_npc") end)
            local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
                rcd.phys.v = Vector3.new(0, 0, 0)
                rcd.phys.w = Vector3.new(0, 0, 0)
            end
            return true
        end
        if isAutoDriveActive() == false and curDistToNpc > 6.5 then
            AutoDrive.request(npcPos, { snap = false, stopNavOnCancel = false })
            AutoDrive.start()
        end
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        local speedKmh = rcd and rcd.phys and rcd.phys.v and (rcd.phys.v.Magnitude * 3.6) or 0
        if (currentPos - lastPos).Magnitude > 2 or speedKmh > 2 then
            lastPos = currentPos
            lastMoveT = os.clock()
        else
            local stillT = os.clock() - lastMoveT
            if curDistToNpc > 8 and stillT > CONFIG.STUCK_TIME_SEC then
                performUnstuck(npcPos)
                lastPos = getCarState() or currentPos
                lastMoveT = os.clock()
            end
        end
        if os.clock() - startTime > timeout then
            pcall(function() AutoDrive.stop("npc_timeout") end)
            break
        end
    end
    return false
end

local function getFuelInfo()
    local fuel, cap = nil, nil
    pcall(function()
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if rcd and rcd.phys and rcd.phys.p then
            fuel = tonumber(rcd.phys.p.fuel)
            cap = tonumber(rcd.phys.p.fuelCap)
        end
        if not fuel or not cap then
            local car = workspace:FindFirstChild("MyCar")
            if car then
                local fAttr = car:GetAttribute("Fuel")
                local cAttr = car:GetAttribute("FuelCap")
                if fAttr then fuel = tonumber(fAttr) end
                if cAttr then cap = tonumber(cAttr) end
            end
        end
    end)
    return fuel, cap
end

local function isRefuelNeeded(beforeQuest)
    if not CONFIG.ENABLE_AUTO_REFUEL then return false end
    local fuel, cap = getFuelInfo()
    if not fuel or not cap or cap <= 0 then return false end
    if beforeQuest then
        local minL = CONFIG.REFUEL_BEFORE_QUEST_MIN_L or 15.0
        local minPct = CONFIG.REFUEL_BEFORE_QUEST_PCT or 0.08
        return (fuel < minL) or ((fuel / cap) < minPct)
    else
        return fuel <= 0.5
    end
end

local function getNearestFuelStation(fromPos)
    if not fromPos then fromPos = getCarState() or CONFIG.NPC_POS end
    local bestStation, bestDist = nil, math.huge
    for _, st in ipairs(CONFIG.FUEL_STATIONS) do
        local stPos = st.pos
        if stPos then
            local d = (fromPos - stPos).Magnitude
            if d < bestDist then
                bestDist = d
                bestStation = { npcId = st.npcId, name = st.name, pos = stPos, dist = d }
            end
        end
    end
    return bestStation
end

