local function parseVector3(val)
    if typeof(val) == "Vector3" then return val end
    if type(val) ~= "string" then return nil end
    local x, y, z = string.match(val, "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
    if x and y and z then return Vector3.new(tonumber(x), tonumber(y), tonumber(z)) end
    return nil
end

local function getActiveObjective(st)
    if not st or (st.state ~= "running" and st.state ~= "boarding") then return nil end
    local q = st.q
    local currentObj = nil
    if q and q.objectives then
        for _, obj in ipairs(q.objectives) do
            if obj.dest and obj.dest.target and not obj.passive then
                local objState = st.objectives and st.objectives[obj.idx]
                local isDone = objState and (objState.done == true)
                if not isDone and (obj.step == st.step or st.step == 0) then
                    currentObj = obj
                    break
                end
            end
        end
    end
    if currentObj then
        local targetPos = parseVector3(currentObj.dest.target)
        if targetPos then
            local isStop = (currentObj.dest.stop == true) or (currentObj.dest.pillar == "stop")
            return {
                idx = currentObj.idx, step = currentObj.step or st.step,
                target = targetPos, isStop = isStop,
                pillar = currentObj.dest.pillar, poly = currentObj.dest.poly
            }
        end
    end
    local nav = (getrenv and getrenv().shared.RaycityNavigation) or shared.RaycityNavigation
    if nav and nav.getGuide then
        local guide = nav.getGuide()
        if guide and (guide.target or guide.goal) then
            local gTarget = guide.target or guide.goal
            local parsedPos = parseVector3(gTarget)
            if parsedPos then
                return {
                    idx = guide.idx or st.step, step = st.step,
                    target = parsedPos, isStop = (guide.stop == true) or (guide.pillar == "stop"),
                    pillar = guide.pillar, poly = nil
                }
            end
        end
    end
    return nil
end

