-- ขับรถกลับเข้าเทียบข้างซิสเตอร์มิแรน (Smooth Drive to Sister Miran)
-- ====================================================================
local function driveToNpcSmooth(timeout)
    if not isRunning or not _G.AutoQuestRunning then return false end
    timeout = timeout or 90

    stopNpcPositionHold()

    local npcPos = getNpcPos()
    local carPos = getCarState()
    if not carPos then return false end

    local distToNpc = (carPos - npcPos).Magnitude

    if distToNpc <= 7.0 then
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if rcd and rcd.phys then
            rcd.phys.throttle = 0
            rcd.phys.brake = 1
            rcd.phys.steerIn = 0
            rcd.phys.v = Vector3.new(0, 0, 0)
        end
        return true
    end

    print(string.format("[AutoQuest] ขับรถกลับเข้าเทียบข้างซิสเตอร์มิแรน (ระยะห่างปัจจุบัน: %.1f studs)...", distToNpc))

    applyAutoDriveParams(true)
    AutoDrive.C.maxSpeed = (distToNpc > 65) and CONFIG.CRUISE_SPEED_MPS or 34.0
    local ok = AutoDrive.request(npcPos, {
        snap = false,
        stopNavOnCancel = false
    })
    if ok then
        AutoDrive.start()
    else
        return false
    end

    local startTime = os.clock()
    local lastPos = carPos
    local lastMoveT = os.clock()

    while isRunning and _G.AutoQuestRunning do
        task.wait(0.05)

        applyCorneringGripAssist()
        maintainHooks()

        local currentPos = getCarState()
        if not currentPos then break end

        npcPos = getNpcPos()
        local curDistToNpc = (currentPos - npcPos).Magnitude

        if curDistToNpc > 65 then
            AutoDrive.C.maxSpeed = CONFIG.CRUISE_SPEED_MPS
        elseif curDistToNpc > 30 then
            AutoDrive.C.maxSpeed = 28.0
        elseif curDistToNpc > 14 then
            AutoDrive.C.maxSpeed = 12.0
        else
            AutoDrive.C.maxSpeed = 4.5
        end

        if curDistToNpc <= 6.5 then
            pcall(function() AutoDrive.stop("reached_npc") end)
            local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
                rcd.phys.v = Vector3.new(0, 0, 0)
                rcd.phys.w = Vector3.new(0, 0, 0)
            end
            print(string.format("[AutoQuest] จอดเทียบข้างซิสเตอร์มิแรนสนิทแล้ว! (ระยะห่าง: %.1f studs)", curDistToNpc))
            return true
        end

        if isAutoDriveActive() == false and curDistToNpc > 6.5 then
            AutoDrive.request(npcPos, { snap = false, stopNavOnCancel = false })
            AutoDrive.start()
        end

        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        local speedKmh = rcd and rcd.phys and rcd.phys.v and (rcd.phys.v.Magnitude * 3.6) or 0

        if (currentPos - lastPos).Magnitude > 2 or speedKmh > 2 then
            lastPos = currentPos
            lastMoveT = os.clock()
        else
            local stillT = os.clock() - lastMoveT
            if curDistToNpc > 8 and stillT > CONFIG.STUCK_TIME_SEC then
                performUnstuck(npcPos)
                lastPos = getCarState() or currentPos
                lastMoveT = os.clock()
            end
        end

        if os.clock() - startTime > timeout then
            pcall(function() AutoDrive.stop("npc_timeout") end)
            break
        end
    end

    return false
end

-- ====================================================================
-- ระบบเติมน้ำมันอัตโนมัติ (Auto-Refuel System)
-- ====================================================================
local function getFuelInfo()
    local fuel = nil
    local cap = nil
    pcall(function()
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if rcd and rcd.phys and rcd.phys.p then
            fuel = tonumber(rcd.phys.p.fuel)
            cap = tonumber(rcd.phys.p.fuelCap)
        end
        if not fuel or not cap then
            local car = workspace:FindFirstChild("MyCar")
            if car then
                local fAttr = car:GetAttribute("Fuel")
                local cAttr = car:GetAttribute("FuelCap")
                if fAttr then fuel = tonumber(fAttr) end
                if cAttr then cap = tonumber(cAttr) end
            end
        end
        if not fuel or not cap then
            local EconomyRules = require(ReplicatedStorage.RCDrive.EconomyRules)
            if EconomyRules and EconomyRules.fuelInfo then
                local info = EconomyRules.fuelInfo()
                if info then
                    fuel = tonumber(info.fuel or info.current)
                    cap = tonumber(info.cap or info.max)
                end
            end
        end
    end)
    return fuel, cap
end

local function isRefuelNeeded(beforeQuest)
    if not CONFIG.ENABLE_AUTO_REFUEL then return false end
    local fuel, cap = getFuelInfo()
    if not fuel or not cap or cap <= 0 then return false end

    if beforeQuest then
        local minL = CONFIG.REFUEL_BEFORE_QUEST_MIN_L or 15.0
        local minPct = CONFIG.REFUEL_BEFORE_QUEST_PCT or 0.08
        return (fuel < minL) or ((fuel / cap) < minPct)
    else
        return fuel <= 0.5
    end
end

local function getNearestFuelStation(fromPos)
    if not fromPos then
        fromPos = getCarState() or CONFIG.NPC_POS
    end
    local bestStation = nil
    local bestDist = math.huge
    for _, st in ipairs(CONFIG.FUEL_STATIONS) do
        local stPos = st.pos
        if not stPos then
            pcall(function()
                local npcs = workspace:FindFirstChild("RBRCNpcs")
                local model = npcs and npcs:FindFirstChild(st.modelName)
                local root = model and (model:FindFirstChild("Root") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
                if root then stPos = root.Position end
            end)
        end
        if stPos then
            local d = (fromPos - stPos).Magnitude
            if d < bestDist then
                bestDist = d
                bestStation = {
                    npcId = st.npcId,
                    name = st.name,
                    pos = stPos,
                    dist = d
                }
            end
        end
    end
    return bestStation
end

local function requestServerRefuel(stationId)
    local refuelSuccess = false
    local TownServicesRemote = nil
    pcall(function()
        local townFolder = ReplicatedStorage:FindFirstChild("RaycityTown")
        local remotes = townFolder and townFolder:FindFirstChild("Remotes")
        TownServicesRemote = remotes and remotes:FindFirstChild("TownServicesRequest")
    end)

    if TownServicesRemote then
        local ok, res = pcall(function()
            return TownServicesRemote:InvokeServer({
                op = "fieldService",
                kind = "fuel",
                npcId = stationId or 800043,
                all = true
            })
        end)
        if ok and (res == true or (type(res) == "table" and res.ok)) then
            refuelSuccess = true
        end
    end

    if not refuelSuccess then
        local ts = (getrenv and getrenv().shared.RaycityTownServices) or shared.RaycityTownServices
