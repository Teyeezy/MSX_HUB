-- ====================================================================
-- ระบบตรวจสอบและรับเควสอัตโนมัติ (Sister Miran / S1 Quest Accept Loop)
-- ====================================================================
local function ensureQuestAccepted(phaseCfg)
    applyPhaseConfig(phaseCfg)
    claimAllDropsAndSellInventory()

    if isRefuelNeeded(true) then
        stopNpcPositionHold()
        ensureFuelReady(true)
    end

    local st = getQuestState()
    if st and (st.state == "running" or st.state == "boarding") and st.questId == phaseCfg.QUEST_ID then
        stopNpcPositionHold()
        return true
    end

    print(string.format("[AutoQuest] ตรวจสอบตำแหน่ง NPC สำหรับเควส %s (%s)...", phaseCfg.QUEST_ID, phaseCfg.NAME))

    for attempt = 1, CONFIG.MAX_ACCEPT_RETRIES do
        if not isRunning or not _G.AutoQuestRunning then
            stopNpcPositionHold()
            return false
        end

        if isRefuelNeeded(true) then
            stopNpcPositionHold()
            ensureFuelReady(true)
        end

        st = getQuestState()
        if st and (st.state == "running" or st.state == "boarding") and st.questId == phaseCfg.QUEST_ID then
            stopNpcPositionHold()
            print(string.format("[AutoQuest] ยืนยันเควส %s เริ่มทำงานแล้ว!", phaseCfg.QUEST_ID))
            return true
        end

        local carPos, carLook = getCarState()
        if not carPos then
            task.wait(0.3)
            continue
        end

        local npcPos = getLiveNpcPos() or phaseCfg.NPC_POS
        local distToNpc = (carPos - npcPos).Magnitude

        if distToNpc > 7.0 then
            stopNpcPositionHold()
            local reachedNpc = driveToNpcSmooth(90)
            if not reachedNpc then
                stopNpcPositionHold()
                warn(string.format("[AutoQuest] ขับไปไม่ถึง %s ในรอบที่ %d -> กำลังลองใหม่...", phaseCfg.NAME, attempt))
                task.wait(0.4)
                continue
            end

            task.wait(0.15)
            carPos, carLook = getCarState()
            if not carPos then continue end
            distToNpc = (carPos - npcPos).Magnitude
        end

        if distToNpc > 8.0 then
            stopNpcPositionHold()
            driveToNpcSmooth(15)
            task.wait(0.2)
            carPos, carLook = getCarState()
            if not carPos then continue end
        end

        startNpcPositionHold()

        -- สั่งคุยและส่งคำสั่งรับเควสทันทีพร้อมส่ง carPos เพื่อผ่านการตรวจระยะของเซิร์ฟเวอร์
        local rq = (getrenv and getrenv().shared.RBRCQuest) or shared.RBRCQuest
        local QuestUI = require(ReplicatedStorage.RBRCQuest.QuestUI)

        if phaseCfg.IS_ROADFIGHT then
            if rq and rq.talk then pcall(rq.talk, phaseCfg.NPC_ID) end
            if QuestRequest then
                pcall(function()
                    QuestRequest:InvokeServer({op = "talk", npcId = phaseCfg.NPC_ID, carPos = carPos})
                end)
            end
            task.wait(0.15)
            if QuestUI and QuestUI.offerShown and QuestUI.offerShown() then
                pcall(function() QuestUI._offerAnswer(true) end)
            end
            if RoadFightRequest then
                pcall(function()
                    RoadFightRequest:InvokeServer({op = "accept", npcId = phaseCfg.NPC_ID, slot = phaseCfg.SLOT or 1})
                end)
            end
        else
            -- Party Taxi (ผู้เงียบงัน / S2)
            if QuestRequest then
                pcall(function()
                    QuestRequest:InvokeServer({op = "talk", npcId = phaseCfg.NPC_ID, carPos = carPos})
                end)
                task.wait(0.08)
                pcall(function()
                    QuestRequest:InvokeServer({op = "accept", questId = phaseCfg.QUEST_ID, npcId = phaseCfg.NPC_ID, carPos = carPos})
                end)
                task.wait(0.08)
                pcall(function()
                    QuestRequest:InvokeServer({op = "boarded", questId = phaseCfg.QUEST_ID, carPos = carPos})
                end)
            end
            if rq and rq.talk then pcall(rq.talk, phaseCfg.NPC_ID) end
            if QuestUI and QuestUI.offerShown and QuestUI.offerShown() then
                pcall(function() QuestUI._offerAnswer(true) end)
            end
        end

        -- Confirm accept and boarded transition
        for waitStep = 1, 30 do
            task.wait(0.1)
            st = getQuestState()
            if st and st.questId == phaseCfg.QUEST_ID then
                if st.state == "running" then
                    stopNpcPositionHold()
                    print(string.format("[AutoQuest] Accepted %s (running)! Starting route!", phaseCfg.NAME))
                    return true
                elseif st.state == "boarding" then
                    stopNpcPositionHold()
                    if QuestRequest then
                        pcall(function()
                            QuestRequest:InvokeServer({op = "boarded", questId = phaseCfg.QUEST_ID})
                        end)
                    end
                end
            end
        end

        task.wait(0.3)
    end

    warn("[AutoQuest] หมดรอบพยายามรับเควส จะวนลูปรอบใหม่...")
    stopNpcPositionHold()
    return false
end

-- ====================================================================
-- ฟังก์ชันรันรอบเควส 1 รอบ (Sister Miran Route Navigator)
-- ====================================================================
local function runOneQuestCycle()
    local currentLv = getPlayerLevel()
    local phaseCfg
    if currentLv < CONFIG.PHASE1_MAX_LEVEL then
        phaseCfg = CONFIG.PHASE1
    else
        phaseCfg = CONFIG.PHASE2
    end
    applyPhaseConfig(phaseCfg)

    local accepted = ensureQuestAccepted(phaseCfg)
    if not accepted then
        print("[AutoQuest] รับเควสไม่สำเร็จ -> พัก 2 วินาทีก่อนลองใหม่...")
        task.wait(2.0)
        return
    end

    print(string.format("[AutoQuest] เริ่มต้นการนำทางเควส %s (%s) [Lv.%d]!", phaseCfg.QUEST_ID, phaseCfg.NAME, currentLv))
    AutoDrive.C.maxSpeed = phaseCfg.CRUISE_SPEED_MPS

    local currentActiveIdx = nil
    local currentActiveTarget = nil
    local currentActiveIsStop = false
    local currentActivePoly = nil
    local stepStartTime = os.clock()
    local lastStuckT = os.clock()
    local lastStuckPos = getCarState()
    local lastDriveRefreshT = os.clock()
    local bestDistanceToTarget = math.huge
    local lastProgressAt = os.clock()
    local lastRouteRestartAt = 0
    local lastUnstuckAt = 0
    local driveInactiveSince = nil
    local questStateUnknownSince = nil
    local lastQuestStateUnknownWarnAt = 0
    local questStateRecoveryRequested = false
    local lastThrillReportAt = 0

    local PASS_THROUGH_RADIUS = 28.0
    local ROUTE_RESTART_COOLDOWN = 3.5
    local NO_PROGRESS_TIMEOUT = 12.0
    local UNSTUCK_COOLDOWN = 10.0
    local lastLootCheckAt = 0

    while isRunning and _G.AutoQuestRunning do
        task.wait(0.06)

        tryAutoBoost()
        applyCorneringGripAssist()
        maintainHooks()

        -- ส่งรายงาน Thrill สม่ำเสมอระหว่างทางเพื่อให้ครบ +70 แต้มแน่นอน
        if CONFIG.ENABLE_AUTO_THRILL and (os.clock() - lastThrillReportAt) >= 1.5 then
            lastThrillReportAt = os.clock()
            pcall(function()
                local rq = (getrenv and getrenv().shared.RBRCQuest) or shared.RBRCQuest
                if rq and rq.reportThrill then
                    rq.reportThrill(2)
                end
                if QuestEventUp then
                    QuestEventUp:FireServer({
                        op = "thrill",
                        count = 2
                    })
                end
            end)
        end

        if os.clock() - lastLootCheckAt >= 1.5 then
            lastLootCheckAt = os.clock()
            claimAllDropsAndSellInventory()
        end

        if isRefuelNeeded(false) then
            warn("[AutoQuest] ⛽ น้ำมันหมดกลางทาง! กำลังขับไปเติมน้ำมันเต็มถัง...")
            local refuelOk = ensureFuelReady(false)
            if refuelOk and currentActiveTarget then
                stepStartTime = os.clock()
                lastStuckT = os.clock()
                lastProgressAt = os.clock()
                applyAutoDriveParams(currentActiveIsStop)
                local ok = AutoDrive.request(currentActiveTarget, {
                    snap = not currentActiveIsStop,
                    stopNavOnCancel = false
                })
                if ok ~= false then
                    pcall(function() AutoDrive.start() end)
                end
            end
        end

        local st = getQuestState()
        if not st then
            local finishConfirmed = false
            if currentActiveIsStop then
                local finishCarPos = getCarState()
                if isHoldingStopBox then
                    finishConfirmed = true
                elseif currentActivePoly then
                    finishConfirmed = isCarInsidePoly(currentActivePoly, finishCarPos)
                elseif finishCarPos and currentActiveTarget then
                    finishConfirmed = (finishCarPos - currentActiveTarget).Magnitude <= 14
                end
            end

            questStateUnknownSince = questStateUnknownSince or os.clock()
            local unknownDuration = os.clock() - questStateUnknownSince
            if finishConfirmed and unknownDuration >= 0.2 then
                print("[AutoQuest] สถานะเควสหายหลังรถเข้าจุดจอดเส้นชัย -> ยืนยันจบรอบ")
                break
            elseif not finishConfirmed then
                if unknownDuration >= CONFIG.QUEST_STATE_UNKNOWN_TIMEOUT then
                    questStateRecoveryRequested = true
                    warn(string.format(
                        "[AutoQuest] อ่านสถานะเควสไม่ได้ต่อเนื่อง %.1f วินาที และยังไม่ยืนยันเส้นชัย -> ออกจากรอบเพื่อกลับไปรับเควสใหม่",
                        unknownDuration
                    ))
                    break
                elseif unknownDuration >= 5 and (os.clock() - lastQuestStateUnknownWarnAt) >= 5 then
                    warn("[AutoQuest] ยังอ่านสถานะเควสไม่ได้และยังไม่ยืนยันจุดเส้นชัย -> รอตรวจสอบต่อ")
                    lastQuestStateUnknownWarnAt = os.clock()
                end
            end

            task.wait(0.2)
            continue
        end

        questStateUnknownSince = nil

        if st.state ~= "running" and st.state ~= "boarding" then
            print("[AutoQuest] Quest is not running or boarding -> end cycle")
            break
        end
        if st.state == "boarding" and QuestRequest then
            pcall(function()
                QuestRequest:InvokeServer({op = "boarded", questId = phaseCfg.QUEST_ID})
            end)
        end
        local activeObj = getActiveObjective(st)
        if not activeObj then
            task.wait(0.08)
            continue
        end

        local targetChanged = currentActiveTarget == nil
            or (activeObj.target - currentActiveTarget).Magnitude > 2
            or activeObj.isStop ~= currentActiveIsStop

        if activeObj.idx ~= currentActiveIdx or targetChanged then
            local reason = activeObj.idx ~= currentActiveIdx and "checkpoint" or "target_update"
            currentActiveIdx = activeObj.idx
            currentActiveTarget = activeObj.target
            currentActiveIsStop = activeObj.isStop
            currentActivePoly = activeObj.poly
            stepStartTime = os.clock()
            lastStuckT = os.clock()
            lastStuckPos = getCarState()
            lastDriveRefreshT = os.clock()
            bestDistanceToTarget = lastStuckPos and (lastStuckPos - activeObj.target).Magnitude or math.huge
            lastProgressAt = os.clock()
            lastRouteRestartAt = 0
            lastUnstuckAt = 0
            driveInactiveSince = nil
            isHoldingStopBox = false

            local chkType = activeObj.isStop and "จุดจอดเข้าเส้นชัย (Finish Line)" or "จุดผ่าน (Pass Checkpoint)"
            print(string.format("[AutoQuest] [%s] [Step %d] ขับสู่ %s (Idx %d): %s", reason, activeObj.step, chkType, activeObj.idx, tostring(activeObj.target)))

            local carPosCurrent = getCarState()
            local initDist = carPosCurrent and (carPosCurrent - activeObj.target).Magnitude or 999
            applyAutoDriveParams(activeObj.isStop and initDist <= 45)

            local requestOk, requestResult = pcall(function()
                return AutoDrive.request(activeObj.target, {
                    snap = not activeObj.isStop,
                    stopNavOnCancel = false
                })
            end)
            if requestOk and requestResult ~= false then
                local startOk, startErr = pcall(function() AutoDrive.start() end)
                if not startOk then warn("[AutoQuest] AutoDrive.start ไม่สำเร็จ:", startErr) end
            else
                warn("[AutoQuest] AutoDrive.request ไม่สำเร็จ:", requestOk and "request returned false" or tostring(requestResult))
                stepStartTime = os.clock() - CONFIG.TIMEOUT_PER_CHK + 2
            end
        end

        local carPosNow = getCarState()
        local distToTarget = carPosNow and (carPosNow - activeObj.target).Magnitude or 999
        local inBox = activeObj.isStop and isCarInsidePoly(activeObj.poly, carPosNow)
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        local speedKmh = rcd and rcd.phys and rcd.phys.v and (rcd.phys.v.Magnitude * 3.6) or 0
        local carRoot = getCarRoot()

        -- ตรวจสอบเมื่อรถชะลอเข้าจอดในจุด STOP เรียบร้อย (Natural Stop at Destination)
        if activeObj.isStop and not isHoldingStopBox then
            -- ถึงจุดหมายเมื่อเข้าลึกในกล่อง (dist <= 3.8 studs) หรืออยู่ในกล่อง inBox และความเร็วชะลอจนหยุดนิ่ง (dist <= 6.0 studs และ speed < 3.0 km/h)
            local arrivedAtStop = (inBox and distToTarget <= 6.0 and speedKmh < 3.0) or (distToTarget <= 3.8)
            if arrivedAtStop then
                isHoldingStopBox = true
                pcall(function() AutoDrive.stop("stopped_at_destination") end)
                print(string.format("[AutoQuest] ค่อยๆ ชะลอเข้าจอดในจุด STOP เรียบร้อย (dist: %.1f studs, speed: %.1f km/h) -> เหยียบเบรกจอดนิ่ง", distToTarget, speedKmh))
            end
        end

        -- เมื่อรถจอดในจุด STOP แล้ว: เหยียบเบรกค้างไว้ ไม่ขยับไปมาจนกว่าเควสจะจบหรือกล่อง STOP หายไป
        if isHoldingStopBox then
            pcall(function() AutoDrive.stop("holding_brake") end)
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
                rcd.phys.v = Vector3.zero
                rcd.phys.w = Vector3.zero
            end
            lastStuckT = os.clock()
            lastProgressAt = os.clock()
            stepStartTime = os.clock()
            task.wait(0.08)
            continue
        end

        -- ระบบค่อยๆ ชะลอความเร็วเฉพาะช่วงใกล้จุด STOP (เริ่มชะลอตั้งแต่ระยะ 50 studs ลงไป)
        if activeObj.isStop and not isHoldingStopBox and carPosNow and carRoot then
            if distToTarget <= 50 then
                local targetSpeedKmh
                if distToTarget > 25 then
                    -- ระยะ 50 -> 25 studs: เริ่มชะลอความเร็วลงมาที่ประมาณ ~30-35 km/h
                    targetSpeedKmh = 18.0 + (distToTarget - 25) * (17.0 / 25.0)
                elseif distToTarget > 10 then
                    -- ระยะ 25 -> 10 studs: ชะลอเหลือประมาณ ~18 km/h
                    targetSpeedKmh = 8.0 + (distToTarget - 10) * (10.0 / 15.0)
                elseif distToTarget > 5 then
                    -- ระยะ 10 -> 5 studs: ไหลคลานช้าๆ ประมาณ ~8 km/h
                    targetSpeedKmh = 4.0 + (distToTarget - 5) * (4.0 / 5.0)
                else
                    -- ระยะ 5 studs ลงไป: คลานเบาๆ ประมาณ ~4 km/h เข้าสู่ใจกลางกล่อง
                    targetSpeedKmh = 4.0
                end

                AutoDrive.C.maxSpeed = targetSpeedKmh / 3.6

                local rel = carRoot.CFrame:PointToObjectSpace(activeObj.target)
                if rcd and rcd.phys then
                    if speedKmh > (targetSpeedKmh + 2.0) then
                        -- ความเร็วเกินเป้าหมาย -> ค่อยๆ แตะเบรกชะลอลงอย่างนุ่มนวล
                        local brakeAmt = math.clamp((speedKmh - targetSpeedKmh) / 10.0, 0.25, 0.85)
                        rcd.phys.throttle = 0
                        rcd.phys.brake = brakeAmt
                    else
                        -- ความเร็วช้าเกินไป -> เติมคันเร่งเบาๆ ประคองส่งตัวเข้ากึ่งกลางกล่อง
                        local throttleAmt = math.clamp(targetSpeedKmh / 22.0, 0.15, 0.45)
                        rcd.phys.throttle = throttleAmt
                        rcd.phys.brake = 0
                    end
                    -- บังคับเลี้ยวตรงเข้าสู่จุดกึ่งกลางกล่อง
                    rcd.phys.steerIn = math.clamp(rel.X * 0.18, -0.65, 0.65)
                end
            end
        end

        local targetBehind = false
        if carPosNow and carRoot then
            local toTarget = activeObj.target - carPosNow
            targetBehind = toTarget:Dot(carRoot.CFrame.LookVector) < -1.0
        end

        local now = os.clock()
        if distToTarget < bestDistanceToTarget - 2.0 then
            bestDistanceToTarget = distToTarget
            lastProgressAt = now
        end

        local passedCurrentCheckpoint = not activeObj.isStop
            and distToTarget <= PASS_THROUGH_RADIUS
            and targetBehind
            and speedKmh >= 8

        local driveActive = isAutoDriveActive()
        if driveActive then
            driveInactiveSince = nil
        else
            driveInactiveSince = driveInactiveSince or now
        end

        if passedCurrentCheckpoint then
            if rcd and rcd.phys then
                rcd.phys.throttle = 1
                rcd.phys.brake = 0
            end
        elseif not inBox and not driveActive
            and driveInactiveSince and (now - driveInactiveSince) >= 1.2
            and (now - lastRouteRestartAt) >= ROUTE_RESTART_COOLDOWN
            and (speedKmh < 8 or (now - lastProgressAt) >= 4.0) then
            warn("[AutoQuest] AutoDrive หยุดและรถไม่คืบหน้า -> ขอเส้นทางใหม่แบบไม่ snap")
            applyAutoDriveParams(activeObj.isStop)
            local ok = AutoDrive.request(activeObj.target, {
                snap = false,
                stopNavOnCancel = false
            })
            if ok ~= false then AutoDrive.start() end
            lastRouteRestartAt = now
            lastDriveRefreshT = now
            lastProgressAt = now
            bestDistanceToTarget = distToTarget
        end

        if not passedCurrentCheckpoint and not activeObj.isStop
            and distToTarget > 20 and distToTarget <= 120
            and (now - lastProgressAt) >= NO_PROGRESS_TIMEOUT
            and (now - lastRouteRestartAt) >= ROUTE_RESTART_COOLDOWN then
            warn("[AutoQuest] รถไม่เข้าใกล้เช็คพอยต์ต่อเนื่อง -> ปรับเส้นทางใหม่หนึ่งครั้ง")
            applyAutoDriveParams(false)
            local ok = AutoDrive.request(activeObj.target, {
                snap = false,
                stopNavOnCancel = false
            })
            if ok ~= false then AutoDrive.start() end
            lastRouteRestartAt = now
            lastDriveRefreshT = now
            lastProgressAt = now
            bestDistanceToTarget = distToTarget
        end

        if carPosNow then
            -- ตรวจสอบรถติด (ป้องกันไม่ให้ถอยหลัง Unstuck ทำงานระหว่างอยู่ในช่วงใกล้จุด STOP หรือช่วง hold)
            if not isHoldingStopBox then
                if (carPosNow - (lastStuckPos or carPosNow)).Magnitude > 3.0 or speedKmh > 5 then
                    lastStuckPos = carPosNow
                    lastStuckT = os.clock()
                elseif (not activeObj.isStop and distToTarget > 12) or (activeObj.isStop and distToTarget > 35) then
                    local stillTime = os.clock() - lastStuckT
                    local limit = activeObj.isStop and 4.0 or CONFIG.STUCK_TIME_SEC
                    if stillTime > limit
                        and (now - lastUnstuckAt) >= UNSTUCK_COOLDOWN
                        and not passedCurrentCheckpoint then
                        lastUnstuckAt = now
                        performUnstuck(activeObj.target)
                        lastStuckPos = getCarState() or carPosNow
                        lastStuckT = os.clock()
                        lastProgressAt = os.clock()
                        bestDistanceToTarget = distToTarget
                        lastRouteRestartAt = os.clock()
                    end
                end
            end

            if os.clock() - stepStartTime > CONFIG.TIMEOUT_PER_CHK
                and (os.clock() - lastRouteRestartAt) >= ROUTE_RESTART_COOLDOWN
                and not passedCurrentCheckpoint
                and not isHoldingStopBox then
                warn("[AutoQuest] เช็คพอยต์เกินเวลา -> รีเฟรชเส้นทางแบบไม่ snap")
                applyAutoDriveParams(activeObj.isStop)
                local ok = AutoDrive.request(activeObj.target, { snap = false, stopNavOnCancel = false })
                if ok ~= false then AutoDrive.start() end
                stepStartTime = os.clock()
                lastStuckT = os.clock()
                lastRouteRestartAt = os.clock()
                lastProgressAt = os.clock()
                bestDistanceToTarget = distToTarget
            end
        end
    end

    AutoDrive.stop(questStateRecoveryRequested and "quest_state_lost" or "quest_done")
    task.wait(0.35)
    claimAllDropsAndSellInventory()

    if isRefuelNeeded(true) then
        print("[AutoQuest] ⛽ จบรอบเควสและน้ำมันเหลือน้อย/หมด -> ขับไปเติมน้ำมันเต็มถังก่อนเริ่มรอบถัดไป...")
        ensureFuelReady(true)
    end

    if questStateRecoveryRequested then
        print("[AutoQuest] กู้คืนรอบหลังอ่านสถานะเควสไม่ได้ -> เริ่มขั้นตอนขับกลับไปหาซิสเตอร์มิแรน เพื่อรับเควสใหม่")
        task.wait(1.0)
    else
        print(string.format("[AutoQuest] จบรอบเควสซิสเตอร์มิแรน! รอ %.1f วินาที แล้วจะขับกลับไปหาซิสเตอร์มิแรน เพื่อวนรอบใหม่...", CONFIG.LOOP_DELAY))
        task.wait(CONFIG.LOOP_DELAY)
    end
    claimAllDropsAndSellInventory()
end

