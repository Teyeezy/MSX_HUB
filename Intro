local function getActiveObjective(st)
    if not st or (st.state ~= "running" and st.state ~= "boarding") then return nil end
    local q = st.q
    if q and q.objectives then
        for _, obj in ipairs(q.objectives) do
            if obj.dest and obj.dest.target and not obj.passive then
                local objState = st.objectives and st.objectives[obj.idx]
                if not (objState and objState.done == true) and (obj.step == st.step or st.step == 0) then
                    local targetPos = parseVector3(obj.dest.target)
                    if targetPos then
                        return {
                            idx = obj.idx,
                            step = obj.step or st.step,
                            target = targetPos,
                            isStop = (obj.dest.stop == true) or (obj.dest.pillar == "stop"),
                            pillar = obj.dest.pillar,
                            poly = obj.dest.poly
                        }
                    end
                end
            end
        end
    end
    return nil
end

local unstuckDir = 1
local function performUnstuck(targetPos)
    pcall(function() AutoDrive.stop("unstuck") end)
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    if rcd and rcd.phys then
        local myCF = getCarRoot() and getCarRoot().CFrame
        local steer = 0.55
        if myCF and targetPos then
            local rel = myCF:PointToObjectSpace(targetPos)
            steer = (rel.X >= 0) and -0.55 or 0.55
        else
            unstuckDir = -unstuckDir
            steer = 0.55 * unstuckDir
        end
        rcd.phys.brake = 0
        rcd.phys.throttle = -0.65
        rcd.phys.steerIn = steer
        task.wait(0.8)
        rcd.phys.throttle = 0
        rcd.phys.steerIn = 0
        rcd.phys.brake = 1
        task.wait(0.15)
        rcd.phys.brake = 0
    end
    if targetPos and isRunning and _G.AutoQuestRunning then
        applyAutoDriveParams(false)
        AutoDrive.request(targetPos, { snap = false, stopNavOnCancel = false })
        AutoDrive.start()
    end
end

local function driveToNpcSmooth(timeout)
    if not isRunning or not _G.AutoQuestRunning then return false end
    timeout = timeout or 90
    stopNpcPositionHold()

    local npcPos = getNpcPos()
    local carPos = getCarState()
    if not carPos then return false end
    local distToNpc = (carPos - npcPos).Magnitude

    if distToNpc <= 7.0 then
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if rcd and rcd.phys then
            rcd.phys.throttle = 0
            rcd.phys.brake = 1
            rcd.phys.steerIn = 0
            rcd.phys.v = Vector3.zero
        end
        return true
    end

    applyAutoDriveParams(true)
    AutoDrive.C.maxSpeed = (distToNpc > 65) and CONFIG.CRUISE_SPEED_MPS or 34.0
    local ok = AutoDrive.request(npcPos, { snap = false, stopNavOnCancel = false })
    if ok then AutoDrive.start() else return false end

    local startTime = os.clock()
    local lastPos = carPos
    local lastMoveT = os.clock()

    while isRunning and _G.AutoQuestRunning do
        task.wait(0.05)
        applyCorneringGripAssist()

        local currentPos = getCarState()
        if not currentPos then break end
        npcPos = getNpcPos()
        local curDistToNpc = (currentPos - npcPos).Magnitude

        if curDistToNpc <= 6.5 then
            pcall(function() AutoDrive.stop("reached_npc") end)
            local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
                rcd.phys.v = Vector3.zero
            end
            return true
        end

        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        local speedKmh = rcd and rcd.phys and rcd.phys.v and (rcd.phys.v.Magnitude * 3.6) or 0
        if (currentPos - lastPos).Magnitude > 2 or speedKmh > 2 then
            lastPos = currentPos
            lastMoveT = os.clock()
        else
            if curDistToNpc > 8 and (os.clock() - lastMoveT) > CONFIG.STUCK_TIME_SEC then
                performUnstuck(npcPos)
                lastPos = getCarState() or currentPos
                lastMoveT = os.clock()
            end
        end

        if os.clock() - startTime > timeout then
            pcall(function() AutoDrive.stop("npc_timeout") end)
            break
        end
    end
    return false
end

local function getFuelInfo()
    local fuel, cap = nil, nil
    pcall(function()
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if rcd and rcd.phys and rcd.phys.p then
            fuel = tonumber(rcd.phys.p.fuel)
            cap = tonumber(rcd.phys.p.fuelCap)
        end
    end)
    return fuel, cap
end

local function isRefuelNeeded(beforeQuest)
    if not CONFIG.ENABLE_AUTO_REFUEL then return false end
    local fuel, cap = getFuelInfo()
    if not fuel or not cap or cap <= 0 then return false end
    if beforeQuest then
        return (fuel < CONFIG.REFUEL_BEFORE_QUEST_MIN_L) or ((fuel / cap) < CONFIG.REFUEL_BEFORE_QUEST_PCT)
    else
        return fuel <= 0.5
    end
end

local function getNearestFuelStation()
    local fromPos = getCarState() or CONFIG.NPC_POS
    local bestStation, bestDist = nil, math.huge
    for _, st in ipairs(CONFIG.FUEL_STATIONS) do
        local d = (fromPos - st.pos).Magnitude
        if d < bestDist then
            bestDist = d
            bestStation = { npcId = st.npcId, name = st.name, pos = st.pos, dist = d }
        end
    end
    return bestStation
end

local function requestServerRefuel(stationId)
    local success = false
    pcall(function()
        local townFolder = ReplicatedStorage:FindFirstChild("RaycityTown")
        local remotes = townFolder and townFolder:FindFirstChild("Remotes")
        local TownServicesRemote = remotes and remotes:FindFirstChild("TownServicesRequest")
        if TownServicesRemote then
            local res = TownServicesRemote:InvokeServer({ op = "fieldService", kind = "fuel", npcId = stationId or 800043, all = true })
            if res == true or (type(res) == "table" and res.ok) then success = true end
        end
    end)
    return success
end

local function driveToFuelAndRefuel(timeout)
    if not isRunning or not _G.AutoQuestRunning then return false end
    timeout = timeout or 120
    local station = getNearestFuelStation()
    if not station then return false end

    applyAutoDriveParams(true)
    AutoDrive.request(station.pos, { snap = false, stopNavOnCancel = false })
    AutoDrive.start()

    local startTime = os.clock()
    while isRunning and _G.AutoQuestRunning do
        task.wait(0.05)
        applyCorneringGripAssist()
        local curPos = getCarState()
        if not curPos then break end
        if (curPos - station.pos).Magnitude <= 7.0 then
            pcall(function() AutoDrive.stop("reached_fuel") end)
            for _ = 1, 4 do
                if requestServerRefuel(station.npcId) then break end
                task.wait(0.5)
            end
            return true
        end
        if os.clock() - startTime > timeout then break end
    end
    return false
end

local function ensureFuelReady(beforeQuest)
    if not CONFIG.ENABLE_AUTO_REFUEL or not isRefuelNeeded(beforeQuest) then return true end
    return driveToFuelAndRefuel(120)
end

