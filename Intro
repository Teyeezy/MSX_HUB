local function setButtonState(running)
    if running then
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(60, 60, 60) }):Play()
        ToggleBtn.Text = "■ STOP"
        Status.Text = "● ONLINE (FARMING)"
        Status.TextColor3 = Color3.fromRGB(255, 50, 50)
        stroke.Color = Color3.fromRGB(255, 50, 50)
        
        if not blinkTween then
            blinkTween = TweenService:Create(stroke, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.5 })
            blinkTween:Play()
        end
    else
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(200, 20, 20) }):Play()
        ToggleBtn.Text = "▶ START"
        Status.Text = "● OFFLINE"
        Status.TextColor3 = Color3.fromRGB(150, 150, 150)
        stroke.Color = Color3.fromRGB(255, 30, 30)
        
        if blinkTween then
            blinkTween:Cancel()
            blinkTween = nil
        end
        stroke.Transparency = 0
    end
end

local function setSellButtonState(enabled)
    if enabled then
        TweenService:Create(ToggleSellBtn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(180, 20, 20) }):Play()
        ToggleSellBtn.Text = "💰 AUTO-SELL: ON"
    else
        TweenService:Create(ToggleSellBtn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(80, 80, 80) }):Play()
        ToggleSellBtn.Text = "💰 AUTO-SELL: OFF"
    end
end

local function setPhaseButtonState()
    if isPhase1 then
        PhaseBtn.Text = "Phase 1: Derix"
        PhaseBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 200) -- สีม่วง
    else
        PhaseBtn.Text = "Phase 2: Min R"
        PhaseBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 200) -- สีน้ำเงิน
    end
    updatePhaseConfig()
end

local function updateStats()
    if not STATS.startTime then return end
    local elapsed = os.time() - STATS.startTime
    local h = math.floor(elapsed / 3600)
    local m = math.floor((elapsed % 3600) / 60)
    local s = elapsed % 60
    TimeLabel.Text = string.format("⏱ TIME: %02d:%02d:%02d", h, m, s)
    
    RainTotalLabel.Text = string.format("💰 RAIN: %s", tostring(STATS.totalRain):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", ""))
    
    if elapsed > 0 then
        local rainPerHour = math.floor((STATS.totalRain / elapsed) * 3600)
        RainHourLabel.Text = string.format("⚡ RAIN/H: %s", tostring(rainPerHour):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", ""))
    end
    
    CycleLabel.Text = string.format("🏁 CYCLES: %d", STATS.totalCycles)
    
    if STATS.avgCycleTime > 0 then
        local avgMin = STATS.avgCycleTime / 60
        AvgTimeLabel.Text = string.format("⏳ AVG/CYCLE: %.2f MIN", avgMin)
    end
end

task.spawn(function()
    while true do
        task.wait(1)
        if STATS.isRunning then
            pcall(updateStats)
        end
    end
end)

