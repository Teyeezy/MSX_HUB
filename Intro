ToggleBtn.MouseLeave:Connect(function()
    TweenService:Create(ToggleBtn, TweenInfo.new(0.15), { Size = UDim2.new(1, -20, 0, 42), Position = UDim2.new(0, 10, 1, -52) }):Play()
