-- === STANDALONE BLACK SCREEN & STATS GUI (Fixed 999 Bug) ===
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 1. สร้าง ScreenGui หลัก
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FarmStatsGui"
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- 2. สร้างพื้นหลังสีดำเต็มจอ
local BlackBackground = Instance.new("Frame")
BlackBackground.Name = "Background"
BlackBackground.Size = UDim2.new(1, 0, 1, 0)
BlackBackground.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
BlackBackground.BorderSizePixel = 0
BlackBackground.Parent = ScreenGui

-- 3. สร้างกล่องข้อความแสดงผล
local TextLabel = Instance.new("TextLabel")
TextLabel.Name = "StatusText"
TextLabel.Size = UDim2.new(0, 600, 0, 220)
TextLabel.Position = UDim2.new(0.5, -300, 0.5, -110)
TextLabel.BackgroundTransparency = 1
TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TextLabel.TextSize = 24
TextLabel.Font = Enum.Font.GothamBold
TextLabel.TextXAlignment = Enum.TextXAlignment.Center
TextLabel.TextYAlignment = Enum.TextYAlignment.Center
TextLabel.Text = "🤖 กำลังเปิดหน้าจอสีดำ..."
TextLabel.Parent = ScreenGui

-- ตัวแปรสถานะหลัก
if not _G.BotStatus then
    _G.BotStatus = "ระบบ GUI พร้อมใช้งาน"
end

-- 4. ระบบอัปเดตหน้าจอแบบเรียลไทม์ (ดึงค่า Emeralds ตัวจริง หลบเลข 999)
local startTime = os.clock()
task.spawn(function()
    while true do
        task.wait(0.3)
        local elapsedSeconds = math.floor(os.clock() - startTime)
        local minutes = math.floor(elapsedSeconds / 60)
        local seconds = elapsedSeconds % 60
        local timeString = string.format("%02d:%02d", minutes, seconds)
        
        -- ดึงค่า Emeralds จาก UI ของเกมโดยกรองค่าที่ไม่ใช่ 999
        local emeralds = "0"
        pcall(function()
            -- เช็คจากโครงสร้าง Main -> BloodGemDisplay -> Count (หรือชื่อสกุลเงินจริง)
            local main = PlayerGui:FindFirstChild("Main")
            if main then
                local display = main:FindFirstChild("BloodGemDisplay") or main:FindFirstChild("EmeraldsDisplay") or main:FindFirstChild("Currency")
                if display then
                    local count = display:FindFirstChild("Count") or display:FindFirstChild("TextLabel")
                    if count and count:IsA("TextLabel") then
                        if count.Text ~= "999" then
                            emeralds = count.Text
                        end
                    end
                end
            end
            
            -- ถ้ายัังไม่ได้ ให้หา TextLabel ที่ไม่ใช่เลข 999
            if emeralds == "0" then
                for _, desc in ipairs(PlayerGui:GetDescendants()) do
                    if desc:IsA("TextLabel") and (desc.Name == "Count" or desc.Name:lower():find("gem") or desc.Name:lower():find("emerald")) then
                        if desc.Text ~= "" and desc.Text ~= "999" and desc.Text ~= "0" then
                            emeralds = desc.Text
                            break
                        end
                    end
                end
            end
        end)
        
        -- แสดงผลบน GUI หน้าจอดำ
        TextLabel.Text = "🤖 ระบบจำลองหน้าจอดำ\n\n" ..
                         "📌 สถานะ: " .. tostring(_G.BotStatus) .. "\n" ..
                         "🟢 Emeralds: " .. tostring(emeralds) .. "\n" ..
                         "⏱️ เวลาที่ใช้: " .. timeString
    end
end)
