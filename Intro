-- === STANDALONE BLACK SCREEN & STATS GUI (Block 999 Fixed) ===
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 1. สร้าง ScreenGui หลัก
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FarmStatsGui"
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- 2. สร้างพื้นหลังสีดำเต็มจอ
local BlackBackground = Instance.new("Frame")
BlackBackground.Name = "Background"
BlackBackground.Size = UDim2.new(1, 0, 1, 0)
BlackBackground.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
BlackBackground.BorderSizePixel = 0
BlackBackground.Parent = ScreenGui

-- 3. สร้างกล่องข้อความแสดงผล
local TextLabel = Instance.new("TextLabel")
TextLabel.Name = "StatusText"
TextLabel.Size = UDim2.new(0, 600, 0, 220)
TextLabel.Position = UDim2.new(0.5, -300, 0.5, -110)
TextLabel.BackgroundTransparency = 1
TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TextLabel.TextSize = 24
TextLabel.Font = Enum.Font.GothamBold
TextLabel.TextXAlignment = Enum.TextXAlignment.Center
TextLabel.TextYAlignment = Enum.TextYAlignment.Center
TextLabel.Text = "🤖 กำลังเปิดหน้าจอสีดำ..."
TextLabel.Parent = ScreenGui

-- ตัวแปรสถานะหลัก
if not _G.BotStatus then
    _G.BotStatus = "ระบบ GUI พร้อมใช้งาน"
end

-- 4. ระบบอัปเดตหน้าจอแบบเรียลไทม์ (กรองเลข 999 ทิ้งทันที)
local startTime = os.clock()
task.spawn(function()
    while true do
        task.wait(0.3)
        local elapsedSeconds = math.floor(os.clock() - startTime)
        local minutes = math.floor(elapsedSeconds / 60)
        local seconds = elapsedSeconds % 60
        local timeString = string.format("%02d:%02d", minutes, seconds)
        
        -- ค้นหาค่า Emeralds พร้อมระบบบล็อกเลข 999
        local emeralds = "0"
        pcall(function()
            for _, desc in ipairs(PlayerGui:GetDescendants()) do
                if desc:IsA("TextLabel") then
                    local textVal = desc.Text
                    -- เช็คว่าไม่ใช่ค่าว่าง, ไม่ใช่เลข 999 และชื่อหรือ Parent มีคำว่า emerald หรือ gem
                    if textVal ~= "" and textVal ~= "999" then
                        local nameLower = desc.Name:lower()
                        local parentName = desc.Parent and desc.Parent.Name:lower() or ""
                        
                        if nameLower:find("emerald") or nameLower:find("gem") or parentName:find("emerald") or parentName:find("gem") then
                            -- เช็คเพิ่มเติมว่าข้างในน่าจะเป็นตัวเลขเงินจริงๆ (เช่น แปลงเป็นตัวเลขได้และไม่เกินค่าแปลกๆ)
                            local num = tonumber(textVal)
                            if num and num ~= 999 then
                                emeralds = textVal
                                break
                            end
                        end
                    end
                end
            end
        end)
        
        -- แสดงผลบน GUI หน้าจอดำ
        TextLabel.Text = "🤖 ระบบจำลองหน้าจอดำ\n\n" ..
                         "📌 สถานะ: " .. tostring(_G.BotStatus) .. "\n" ..
                         "🟢 Emeralds: " .. tostring(emeralds) .. "\n" ..
                         "⏱️ เวลาที่ใช้: " .. timeString
    end
end)
