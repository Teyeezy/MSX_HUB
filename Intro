local function updateStats()
    if not STATS.startTime then return end
    local elapsed = os.time() - STATS.startTime
    local h = math.floor(elapsed / 3600)
    local m = math.floor((elapsed % 3600) / 60)
    local s = elapsed % 60
    TimeLabel:SetText(string.format("⏱ TIME: %02d:%02d:%02d", h, m, s))
    RainTotalLabel:SetText(string.format("💰 RAIN: %s", tostring(STATS.totalRain):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", "")))
    if elapsed > 0 then
        local rainPerHour = math.floor((STATS.totalRain / elapsed) * 3600)
        RainHourLabel:SetText(string.format("⚡ RAIN/H: %s", tostring(rainPerHour):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", "")))
    end
    CycleLabel:SetText(string.format("🏁 CYCLES: %d", STATS.totalCycles))
    if STATS.avgCycleTime > 0 then
        local avgMin = STATS.avgCycleTime / 60
        AvgTimeLabel:SetText(string.format("⏳ AVG/CYCLE: %.2f MIN", avgMin))
    end
end

