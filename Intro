local function createGui()
    local parent
    pcall(function()
        parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)
    if not parent then
        parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    local old = parent:FindFirstChild("AutoFarmStatusGui")
    if old then old:Destroy() end

    local screen = Instance.new("ScreenGui")
    screen.Name = "AutoFarmStatusGui"
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent = parent

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 280, 0, 210)
    frame.Position = UDim2.new(0, 20, 0.5, -105)
    frame.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = screen
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(70, 130, 255)
    stroke.Thickness = 1.5

    -- Title bar (ลากเพื่อย้ายได้)
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 32)
    title.BackgroundColor3 = Color3.fromRGB(40, 70, 150)
    title.BorderSizePixel = 0
    title.Font = Enum.Font.GothamBold
    title.TextSize = 15
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Text = "  ⚡ Auto Farm Status"
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame
    Instance.new("UICorner", title).CornerRadius = UDim.new(0, 10)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 26, 0, 22)
    closeBtn.Position = UDim2.new(1, -32, 0, 5)
    closeBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    closeBtn.Text = "X"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 13
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.BorderSizePixel = 0
    closeBtn.Parent = title
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)
    closeBtn.MouseButton1Click:Connect(function()
        screen:Destroy()
    end)

    local function makeRow(y, caption)
        local cap = Instance.new("TextLabel")
        cap.Size = UDim2.new(0, 90, 0, 22)
        cap.Position = UDim2.new(0, 12, 0, y)
        cap.BackgroundTransparency = 1
        cap.Font = Enum.Font.Gotham
        cap.TextSize = 13
        cap.TextColor3 = Color3.fromRGB(160, 170, 190)
        cap.TextXAlignment = Enum.TextXAlignment.Left
        cap.Text = caption
        cap.Parent = frame

        local val = Instance.new("TextLabel")
        val.Size = UDim2.new(1, -110, 0, 22)
        val.Position = UDim2.new(0, 100, 0, y)
        val.BackgroundTransparency = 1
        val.Font = Enum.Font.GothamMedium
        val.TextSize = 13
        val.TextColor3 = Color3.new(1, 1, 1)
        val.TextXAlignment = Enum.TextXAlignment.Left
        val.TextTruncate = Enum.TextTruncate.AtEnd
        val.Text = "-"
        val.Parent = frame
        return val
    end

    gui.Step = makeRow(42, "ขั้นตอน:")
    gui.Time = makeRow(68, "เวลาที่ใช้:")
    gui.Fuel = makeRow(94, "เชื้อเพลิง:")
    gui.Box = makeRow(150, "Power Box:")
    gui.Result = makeRow(176, "ผลลัพธ์:")

    -- Progress bar เชื้อเพลิง
    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(1, -24, 0, 10)
    barBg.Position = UDim2.new(0, 12, 0, 122)
    barBg.BackgroundColor3 = Color3.fromRGB(50, 50, 62)
    barBg.BorderSizePixel = 0
    barBg.Parent = frame
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
    barFill.BorderSizePixel = 0
    barFill.Parent = barBg
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)
    gui.BarFill = barFill

    -- Drag
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    gui.Screen = screen
end

local function formatTime(t)
    local m = math.floor(t / 60)
    local s = t - m * 60
    return string.format("%02d:%04.1f", m, s)
end

local function setStep(text)
    if gui.Step then gui.Step.Text = text end
end

local function setFuel(count)
    if gui.Fuel then gui.Fuel.Text = count .. " / " .. FUEL_TARGET .. " ชิ้น" end
    if gui.BarFill then
        local ratio = math.clamp(count / math.max(FUEL_TARGET, 1), 0, 1)
        gui.BarFill:TweenSize(UDim2.new(ratio, 0, 1, 0), "Out", "Quad", 0.25, true)
    end
end

local function setBox(text, color)
    if gui.Box then
        gui.Box.Text = text
        gui.Box.TextColor3 = color or Color3.new(1, 1, 1)
    end
end

local function setResult(text, color)
    if gui.Result then
        gui.Result.Text = text
        gui.Result.TextColor3 = color or Color3.new(1, 1, 1)
    end
end

