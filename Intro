local function applyCorneringGripAssist()
    if not CONFIG.ENABLE_CORNERING_ASSIST or npcPositionHoldConn ~= nil or isHoldingStopBox then return end
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    local phys = rcd and rcd.phys
    if not phys or not phys.v then return end

    if phys.p then
        phys.p.redRpm = math.max(phys.p.redRpm or 6000, 9200)
        phys.p.maxRpm = math.max(phys.p.maxRpm or 7830, 10800)
        phys.p.vmax = math.max(phys.p.vmax or 100, 115)
        phys.p.btPower = math.max(phys.p.btPower or 2.5, 3.8)
        phys.p.btOver = math.max(phys.p.btOver or 1.12, 1.35)
    end
    phys.torqueBonus = math.max(phys.torqueBonus or 0, 550)
    phys.gripScale = math.max(phys.gripScale or 1, 2.8)

    if not adState or not adState.active or adState.near then return end
    local path = adState.path
    if not path or not path.n or path.n < 2 or not path.len or path.len < 2 then return end
    if not path._sanitized then sanitizePath(path) end

    local root = getCarRootCached()
    if not root or root.Anchored then return end
    local car = rcd.car
    if typeof(car) ~= "Instance" or not car.Parent then car = workspace:FindFirstChild("MyCar") end
    if not car then return end

    local cf = root.CFrame
    local pos = cf.Position
    local fwd = flatDir(cf.LookVector, Vector3.new(0, 0, -1))
    local v = phys.v
    local speed = Vector3.new(v.X, 0, v.Z).Magnitude

    local sNow, lat, segIdx = pathProject(path, pos, adState.pathHint)
    adState.pathHint = segIdx
    if path.len - sNow < 1.5 then return end

    local scanLen = math.clamp(speed * 1.5, 28, 95)
    local here = pathPointAt(path, sNow)
    local prevDir = flatDir(pathPointAt(path, sNow + 4) - here, fwd)
    local minCos = 1
    local s = sNow + 4
    while s < sNow + scanLen do
        local a = pathPointAt(path, s)
        local b = pathPointAt(path, s + 4)
        local d = flatDir(b - a, prevDir)
        local c = d:Dot(prevDir)
        if c < minCos then minCos = c end
        prevDir = d
        s = s + 4
    end
    local roadDir = flatDir(pathPointAt(path, sNow + 3) - here, fwd)
    local safe = AutoDrive.C.maxSpeed or CONFIG.CRUISE_SPEED_MPS
    local aim = math.clamp(6.5 + speed * 0.20 - lat * 0.30, 5.0, 22)
    local target = pathPointAt(path, sNow + aim)
    local want = flatDir(target - pos, roadDir)
    local cosErr = fwd:Dot(want)
    local rel = cf:VectorToObjectSpace(want)
    local yawRate = phys.w and phys.w.Y or 0

    local steer
    if cosErr < 0.2 then
        steer = rel.X > 0 and -1 or 1
    else
        steer = math.clamp(-rel.X * 2.0 - yawRate * 0.11, -1, 1)
        if math.abs(steer) < 0.015 then steer = 0 end
    end

    local throttle = car:GetAttribute("AutoThrottle") or phys.throttle or 0
    local brake = car:GetAttribute("AutoBrake") or phys.brake or 0
    if speed > safe + 1.5 then
        throttle, brake = 0, math.clamp((speed - safe) / 8, 0.35, 1)
    elseif speed < safe - 1 and brake == 0 then
        throttle = 1
    end

    car:SetAttribute("AutoSteer", steer)
    car:SetAttribute("AutoThrottle", throttle)
    car:SetAttribute("AutoBrake", brake)
    phys.steerIn = steer
    phys.aiSteer = (math.abs(rel.X) > 0.06 or lat > 2.5 or minCos < 0.94)
    phys.gripScale = 2.8
end

