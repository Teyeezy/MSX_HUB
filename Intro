local function startNpcPositionHold()
    if npcPositionHoldConn then return true end
    local root = getCarRoot()
    if not root then return false end
    pcall(function() AutoDrive.stop("npc_hold") end)
    npcPositionHoldCFrame = root.CFrame
    local lastQuestStateCheck = 0
    local questStarted = false
    npcPositionHoldConn = RunService.Heartbeat:Connect(function()
        if os.clock() - lastQuestStateCheck >= 0.2 then
            lastQuestStateCheck = os.clock()
            local st = getQuestState()
            questStarted = st ~= nil and (st.state == "running" or st.state == "boarding") and st.questId == CONFIG.QUEST_ID
        end
        if not _G.AutoQuestRunning or questStarted then
            stopNpcPositionHold()
            return
        end
        local currentRoot = getCarRoot()
        if currentRoot and npcPositionHoldCFrame then
            pcall(function()
                currentRoot.CFrame = npcPositionHoldCFrame
                currentRoot.AssemblyLinearVelocity = Vector3.zero
                currentRoot.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if rcd and rcd.phys then
            rcd.phys.throttle = 0
            rcd.phys.brake = 1
            rcd.phys.steerIn = 0
            rcd.phys.v = Vector3.zero
            rcd.phys.w = Vector3.zero
        end
    end)
    return true
end

