local function performUnstuck(targetPos)
    pcall(function() AutoDrive.stop("unstuck") end)
    local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
    if rcd and rcd.phys then
        local myCF = getCarRoot() and getCarRoot().CFrame
        local steer = 0.55
        if myCF and targetPos then
            local rel = myCF:PointToObjectSpace(targetPos)
            steer = (rel.X >= 0) and -0.55 or 0.55
        else
            unstuckDir = -unstuckDir
            steer = 0.55 * unstuckDir
        end
        rcd.phys.brake = 0
        rcd.phys.throttle = -0.65
        rcd.phys.steerIn = steer
        task.wait(0.7)
        rcd.phys.throttle = 0
        rcd.phys.steerIn = 0
        rcd.phys.brake = 1
        task.wait(0.12)
        rcd.phys.brake = 0
    end
    if targetPos and _G.AutoQuestRunning then
        -- ไม่ต้องใช้ AutoDrive แล้ว
    end
end

local function driveToNpcSmooth(timeout)
    if not _G.AutoQuestRunning then return false end
    timeout = timeout or 90
    stopNpcPositionHold()
    local npcPos = getNpcPos()
    local carPos = getCarState()
    if not carPos then return false end
    local distToNpc = (carPos - npcPos).Magnitude
    if distToNpc <= 7.0 then
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if rcd and rcd.phys then
            rcd.phys.throttle = 0
            rcd.phys.brake = 1
            rcd.phys.steerIn = 0
            rcd.phys.v = Vector3.new(0, 0, 0)
        end
        return true
    end
    local startTime = os.clock()
    local lastPos = carPos
    local lastMoveT = os.clock()
    while _G.AutoQuestRunning do
        task.wait(0.04)
        maintainHooks()
        local currentPos = getCarState()
        if not currentPos then break end
        npcPos = getNpcPos()
        local curDistToNpc = (currentPos - npcPos).Magnitude
        local carRoot = getCarRoot()
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if carRoot and rcd and rcd.phys then
            local relDir = carRoot.CFrame:PointToObjectSpace(npcPos)
            local steer = math.clamp(relDir.X * 2, -1, 1)
            local targetSpeed = 20
            if curDistToNpc < 30 then targetSpeed = 5 end
            if curDistToNpc < 10 then targetSpeed = 2 end
            local currentSpeed = rcd.phys.v.Magnitude
            local throttle = 1
            local brake = 0
            if currentSpeed > targetSpeed + 1 then throttle = 0; brake = 0.5
            elseif currentSpeed > targetSpeed then throttle = 0; brake = 0.1 end
            rcd.phys.steerIn = steer
            rcd.phys.throttle = throttle
            rcd.phys.brake = brake
        end
        if curDistToNpc <= 6.5 then
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
                rcd.phys.v = Vector3.new(0, 0, 0)
                rcd.phys.w = Vector3.new(0, 0, 0)
            end
            return true
        end
        if (currentPos - lastPos).Magnitude > 2 then
            lastPos = currentPos
            lastMoveT = os.clock()
        else
            local stillT = os.clock() - lastMoveT
            if curDistToNpc > 8 and stillT > CONFIG.STUCK_TIME_SEC then
                performUnstuck(npcPos)
                lastPos = getCarState() or currentPos
                lastMoveT = os.clock()
            end
        end
        if os.clock() - startTime > timeout then
            break
        end
    end
    return false
end

local function getFuelInfo()
    local fuel, cap = nil, nil
    pcall(function()
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if rcd and rcd.phys and rcd.phys.p then
            fuel = tonumber(rcd.phys.p.fuel)
            cap = tonumber(rcd.phys.p.fuelCap)
        end
        if not fuel or not cap then
            local car = workspace:FindFirstChild("MyCar")
            if car then
                local fAttr = car:GetAttribute("Fuel")
                local cAttr = car:GetAttribute("FuelCap")
                if fAttr then fuel = tonumber(fAttr) end
                if cAttr then cap = tonumber(cAttr) end
            end
        end
    end)
    return fuel, cap
end

local function isRefuelNeeded(beforeQuest)
    if not CONFIG.ENABLE_AUTO_REFUEL then return false end
    local fuel, cap = getFuelInfo()
    if not fuel or not cap or cap <= 0 then return false end
    if beforeQuest then
        local minL = CONFIG.REFUEL_BEFORE_QUEST_MIN_L or 15.0
        local minPct = CONFIG.REFUEL_BEFORE_QUEST_PCT or 0.08
        return (fuel < minL) or ((fuel / cap) < minPct)
    else
        return fuel <= 0.5
    end
end

local function getNearestFuelStation(fromPos)
    if not fromPos then fromPos = getCarState() or CONFIG.NPC_POS end
    local bestStation, bestDist = nil, math.huge
    for _, st in ipairs(CONFIG.FUEL_STATIONS) do
        local stPos = st.pos
        if stPos then
            local d = (fromPos - stPos).Magnitude
            if d < bestDist then
                bestDist = d
                bestStation = { npcId = st.npcId, name = st.name, pos = stPos, dist = d }
            end
        end
    end
    return bestStation
end

local function requestServerRefuel(stationId)
    local refuelSuccess = false
    local TownServicesRemote = nil
    pcall(function()
        local townFolder = ReplicatedStorage:FindFirstChild("RaycityTown")
        local remotes = townFolder and townFolder:FindFirstChild("Remotes")
        TownServicesRemote = remotes and remotes:FindFirstChild("TownServicesRequest")
    end)
    if TownServicesRemote then
        local ok, res = pcall(function()
            return TownServicesRemote:InvokeServer({ op = "fieldService", kind = "fuel", npcId = stationId or 800043, all = true })
        end)
        if ok and (res == true or (type(res) == "table" and res.ok)) then refuelSuccess = true end
    end
    if not refuelSuccess then
        local ts = (getrenv and getrenv().shared.RaycityTownServices) or shared.RaycityTownServices
        if ts and ts.request then
            local ok, res = pcall(ts.request, "fieldService", { kind = "fuel", npcId = stationId or 800043, all = true })
            if ok and (res == true or (type(res) == "table" and res.ok)) then refuelSuccess = true end
        end
    end
    return refuelSuccess
end

local function driveToFuelAndRefuel(timeout)
    if not _G.AutoQuestRunning then return false end
    timeout = timeout or 120
    local carPos = getCarState()
    local station = getNearestFuelStation(carPos)
    if not station then return false end
    local startTime = os.clock()
    local lastPos = carPos
    local lastMoveT = os.clock()
    while _G.AutoQuestRunning do
        task.wait(0.04)
        maintainHooks()
        local curPos = getCarState()
        if not curPos then break end
        local distToStation = (curPos - station.pos).Magnitude
        local carRoot = getCarRoot()
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        if carRoot and rcd and rcd.phys then
            local relDir = carRoot.CFrame:PointToObjectSpace(station.pos)
            local steer = math.clamp(relDir.X * 2, -1, 1)
            local targetSpeed = 20
            if distToStation < 30 then targetSpeed = 5 end
            if distToStation < 10 then targetSpeed = 2 end
            local currentSpeed = rcd.phys.v.Magnitude
            local throttle = 1
            local brake = 0
            if currentSpeed > targetSpeed + 1 then throttle = 0; brake = 0.5
            elseif currentSpeed > targetSpeed then throttle = 0; brake = 0.1 end
            rcd.phys.steerIn = steer
            rcd.phys.throttle = throttle
            rcd.phys.brake = brake
        end
        if distToStation <= 7.0 then
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
                rcd.phys.v = Vector3.new(0, 0, 0)
                rcd.phys.w = Vector3.new(0, 0, 0)
            end
            humanWait(0.3, 0.1)
            for attempt = 1, 4 do
                if requestServerRefuel(station.npcId) then break end
                humanWait(0.4, 0.2)
            end
            humanWait(0.5, 0.1)
            return true
        end
        if (curPos - lastPos).Magnitude > 2 then
            lastPos = curPos
            lastMoveT = os.clock()
        else
            local stillT = os.clock() - lastMoveT
            if distToStation > 8 and stillT > CONFIG.STUCK_TIME_SEC then
                performUnstuck(station.pos)
                lastPos = getCarState() or curPos
                lastMoveT = os.clock()
            end
        end
        if os.clock() - startTime > timeout then
            break
        end
    end
    return false
end

local function ensureFuelReady(beforeQuest)
    if not CONFIG.ENABLE_AUTO_REFUEL then return true end
    if not isRefuelNeeded(beforeQuest) then return true end
    return driveToFuelAndRefuel(120)
end

