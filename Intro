-- ⚡ รับเควสไวขึ้น (ลดดีเลย์ทุกจุด)
local function ensureQuestAccepted()
    claimAllDropsAndSellInventory()
    if isRefuelNeeded(true) then
        stopNpcPositionHold()
        ensureFuelReady(true)
    end
    local st = getQuestState()
    if st and (st.state == "running" or st.state == "boarding") and st.questId == CONFIG.QUEST_ID then
        stopNpcPositionHold()
        return true
    end
    for attempt = 1, CONFIG.MAX_ACCEPT_RETRIES do
        if not _G.AutoQuestRunning then
            stopNpcPositionHold()
            return false
        end
        if isRefuelNeeded(true) then
            stopNpcPositionHold()
            ensureFuelReady(true)
        end
        st = getQuestState()
        if st and (st.state == "running" or st.state == "boarding") and st.questId == CONFIG.QUEST_ID then
            stopNpcPositionHold()
            return true
        end
        local carPos = getCarState()
        if not carPos then task.wait(0.2); continue end
        local npcPos = getLiveNpcPos() or CONFIG.NPC_POS
        local distToNpc = (carPos - npcPos).Magnitude
        if distToNpc > 7.0 then
            stopNpcPositionHold()
            local reachedNpc = driveToNpcSmooth(90)
            if not reachedNpc then
                stopNpcPositionHold()
                task.wait(0.3)
                continue
            end
            task.wait(0.08)
            carPos = getCarState()
            if not carPos then continue end
            distToNpc = (carPos - npcPos).Magnitude
        end
        if distToNpc > 8.0 then
            stopNpcPositionHold()
            driveToNpcSmooth(15)
            task.wait(0.12)
            carPos = getCarState()
            if not carPos then continue end
        end
        startNpcPositionHold()
        -- ⚡ ยิงทุกคำสั่งรัวๆ ไม่รอ
        if QuestRequest then
            pcall(function()
                QuestRequest:InvokeServer({ op = "talk", npcId = CONFIG.NPC_ID, carPos = carPos })
            end)
            task.wait(CONFIG.ACCEPT_DELAY_TALK)
            pcall(function()
                QuestRequest:InvokeServer({ op = "accept", questId = CONFIG.QUEST_ID, npcId = CONFIG.NPC_ID, carPos = carPos })
            end)
            task.wait(CONFIG.ACCEPT_DELAY_ACCEPT)
            pcall(function()
                QuestRequest:InvokeServer({ op = "boarded", questId = CONFIG.QUEST_ID, carPos = carPos })
            end)
        end
        local rq = (getrenv and getrenv().shared.RBRCQuest) or shared.RBRCQuest
        if rq and rq.talk then pcall(rq.talk, CONFIG.NPC_ID) end
        local QuestUI = require(ReplicatedStorage.RBRCQuest.QuestUI)
        if QuestUI and QuestUI.offerShown and QuestUI.offerShown() then
            pcall(function() QuestUI._offerAnswer(true) end)
        end
        -- ⚡ poll ไวขึ้น
        for waitStep = 1, CONFIG.ACCEPT_POLL_MAX do
            task.wait(CONFIG.ACCEPT_POLL_INTERVAL)
            st = getQuestState()
            if st and st.questId == CONFIG.QUEST_ID then
                if st.state == "running" then
                    stopNpcPositionHold()
                    return true
                elseif st.state == "boarding" then
                    stopNpcPositionHold()
                    if QuestRequest then
                        pcall(function()
                            QuestRequest:InvokeServer({ op = "boarded", questId = CONFIG.QUEST_ID })
                        end)
                    end
                end
            end
        end
        task.wait(0.2)
    end
    stopNpcPositionHold()
    return false
end

-- ⏱️ จบเควส: รอนานขึ้น ให้เควสจบจริง
local function runOneQuestCycle()
    local currentLv = getPlayerLevel()
    local accepted = ensureQuestAccepted()
    if not accepted then
        task.wait(2.0)
        return
    end
    AutoDrive.C.maxSpeed = CONFIG.CRUISE_SPEED_MPS
    local currentActiveIdx, currentActiveTarget, currentActiveIsStop, currentActivePoly = nil, nil, false, nil
    local stepStartTime = os.clock()
    local lastStuckT = os.clock()
    local lastStuckPos = getCarState()
    local lastDriveRefreshT = os.clock()
    local bestDistanceToTarget = math.huge
    local lastProgressAt = os.clock()
    local lastRouteRestartAt = 0
    local lastUnstuckAt = 0
    local driveInactiveSince = nil
    local questStateUnknownSince = nil
    local lastQuestStateUnknownWarnAt = 0
    local questStateRecoveryRequested = false
    local lastThrillReportAt = 0
    local PASS_THROUGH_RADIUS = 28.0
    local ROUTE_RESTART_COOLDOWN = 3.5
    local NO_PROGRESS_TIMEOUT = 12.0
    local UNSTUCK_COOLDOWN = 10.0
    local lastLootCheckAt = 0
    -- ⏱️ ตัวแปรจับเวลาหลัง STOP
    local stopEnteredAt = nil
    local questFinishedConfirmedAt = nil
    while _G.AutoQuestRunning do
        task.wait(0.05)
        tryAutoBoost()
        applyCorneringGripAssist()
        maintainHooks()
        if CONFIG.ENABLE_AUTO_THRILL and (os.clock() - lastThrillReportAt) >= 1.5 then
            lastThrillReportAt = os.clock()
            pcall(function()
                local rq = (getrenv and getrenv().shared.RBRCQuest) or shared.RBRCQuest
                if rq and rq.reportThrill then rq.reportThrill(2) end
                if QuestEventUp then
                    QuestEventUp:FireServer({ op = "thrill", count = 2 })
                end
            end)
        end
        if os.clock() - lastLootCheckAt >= 1.5 then
            lastLootCheckAt = os.clock()
            claimAllDropsAndSellInventory()
        end
        if isRefuelNeeded(false) then
            local refuelOk = ensureFuelReady(false)
            if refuelOk and currentActiveTarget then
                stepStartTime = os.clock()
                lastStuckT = os.clock()
                lastProgressAt = os.clock()
                applyAutoDriveParams(currentActiveIsStop)
                local ok = AutoDrive.request(currentActiveTarget, { snap = not currentActiveIsStop, stopNavOnCancel = false })
                if ok ~= false then pcall(function() AutoDrive.start() end) end
            end
        end
        local st = getQuestState()

        -- ⏱️ ตรวจสอบการจบเควสอย่างละเอียด
        if not st then
            local finishConfirmed = false
            if currentActiveIsStop then
                local finishCarPos = getCarState()
                if isHoldingStopBox then finishConfirmed = true
                elseif currentActivePoly then finishConfirmed = isCarInsidePoly(currentActivePoly, finishCarPos)
                elseif finishCarPos and currentActiveTarget then finishConfirmed = (finishCarPos - currentActiveTarget).Magnitude <= 14 end
            end
            if not questFinishedConfirmedAt then
                questFinishedConfirmedAt = os.clock()
                print("[AutoQuest] ⏳ สถานะเควสหาย -> เริ่มนับเวลายืนยันจบ...")
            end
            local confirmElapsed = os.clock() - questFinishedConfirmedAt
            -- ⏱️ รอ confirmation นานขึ้นถึง 5 วินาที
            if finishConfirmed and confirmElapsed >= 0.3 then
                print(string.format("[AutoQuest] ✅ ยืนยันเควสจบ (รอ %.2f วิ) -> รอต่ออีก %.1f วิ ให้เควสจบจริง", confirmElapsed, CONFIG.STOP_HOLD_TIME))
                task.wait(CONFIG.STOP_HOLD_TIME)
                print("[AutoQuest] 🏁 เควสจบสมบูรณ์ -> เริ่มรอบใหม่")
                break
            elseif not finishConfirmed and confirmElapsed >= CONFIG.QUEST_FINISH_CONFIRM_TIME then
                questStateRecoveryRequested = true
                break
            end
            task.wait(0.15)
            continue
        end
        questStateUnknownSince = nil
        questFinishedConfirmedAt = nil

        if st.state ~= "running" and st.state ~= "boarding" then
            print("[AutoQuest] 🏁 Quest state ไม่อยู่ใน running/boarding -> รอ "..CONFIG.STOP_HOLD_TIME.." วิ ให้เซิร์ฟเวอร์จบเควส")
            task.wait(CONFIG.STOP_HOLD_TIME)
            break
        end
        if st.state == "boarding" and QuestRequest then
            pcall(function() QuestRequest:InvokeServer({ op = "boarded", questId = CONFIG.QUEST_ID }) end)
        end
        local activeObj = getActiveObjective(st)
        if not activeObj then task.wait(0.08); continue end
        local targetChanged = currentActiveTarget == nil
            or (activeObj.target - currentActiveTarget).Magnitude > 2
            or activeObj.isStop ~= currentActiveIsStop
        if activeObj.idx ~= currentActiveIdx or targetChanged then
            currentActiveIdx = activeObj.idx
            currentActiveTarget = activeObj.target
            currentActiveIsStop = activeObj.isStop
            currentActivePoly = activeObj.poly
            stepStartTime = os.clock()
            lastStuckT = os.clock()
            lastStuckPos = getCarState()
            lastDriveRefreshT = os.clock()
            bestDistanceToTarget = lastStuckPos and (lastStuckPos - activeObj.target).Magnitude or math.huge
            lastProgressAt = os.clock()
            lastRouteRestartAt = 0
            lastUnstuckAt = 0
            driveInactiveSince = nil
            isHoldingStopBox = false
            stopEnteredAt = nil
            print(string.format("[AutoQuest] 🎯 ขับสู่ %s (Idx %d): %s",
                activeObj.isStop and "จุดจอดเส้นชัย" or "จุดผ่าน",
                activeObj.idx, tostring(activeObj.target)))
            local carPosCurrent = getCarState()
            local initDist = carPosCurrent and (carPosCurrent - activeObj.target).Magnitude or 999
            applyAutoDriveParams(activeObj.isStop and initDist <= 45)
            local requestOk, requestResult = pcall(function()
                return AutoDrive.request(activeObj.target, { snap = not activeObj.isStop, stopNavOnCancel = false })
            end)
            if requestOk and requestResult ~= false then
                pcall(function() AutoDrive.start() end)
            else
                stepStartTime = os.clock() - CONFIG.TIMEOUT_PER_CHK + 2
            end
        end
        local carPosNow = getCarState()
        local distToTarget = carPosNow and (carPosNow - activeObj.target).Magnitude or 999
        local inBox = activeObj.isStop and isCarInsidePoly(activeObj.poly, carPosNow)
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        local speedKmh = rcd and rcd.phys and rcd.phys.v and (rcd.phys.v.Magnitude * 3.6) or 0
        local carRoot = getCarRoot()
        if activeObj.isStop and not isHoldingStopBox then
            local arrivedAtStop = (inBox and distToTarget <= 6.0 and speedKmh < 3.0) or (distToTarget <= 3.8)
            if arrivedAtStop then
                isHoldingStopBox = true
                stopEnteredAt = os.clock()
                pcall(function() AutoDrive.stop("stopped_at_destination") end)
                print(string.format("[AutoQuest] 🅿️ เข้าจอด STOP แล้ว (%.1f studs, %.1f km/h) -> เหยียบเบรก รอเควสจบ", distToTarget, speedKmh))
            end
        end
        if isHoldingStopBox then
            pcall(function() AutoDrive.stop("holding_brake") end)
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
                rcd.phys.v = Vector3.zero
                rcd.phys.w = Vector3.zero
            end
            lastStuckT = os.clock()
            lastProgressAt = os.clock()
            stepStartTime = os.clock()
            -- ⏱️ ถ้าอยู่ใน STOP นานเกิน STOP_HOLD_TIME + 2 วิ แต่เควสยังไม่จบ -> ตรวจซ้ำ / บังคับจบ
            if stopEnteredAt and (os.clock() - stopEnteredAt) > (CONFIG.STOP_HOLD_TIME + 2.0) then
                local stCheck = getQuestState()
                if not stCheck or (stCheck.state ~= "running" and stCheck.state ~= "boarding") then
                    print("[AutoQuest] ✅ เควสจบหลังถือ STOP นาน -> เริ่มรอบใหม่")
                    task.wait(CONFIG.STOP_HOLD_TIME)
                    break
                end
            end
            task.wait(0.08)
            continue
        end
        if activeObj.isStop and not isHoldingStopBox and carPosNow and carRoot then
            if distToTarget <= 50 then
                local targetSpeedKmh
                if distToTarget > 25 then targetSpeedKmh = 18.0 + (distToTarget - 25) * (17.0 / 25.0)
                elseif distToTarget > 10 then targetSpeedKmh = 8.0 + (distToTarget - 10) * (10.0 / 15.0)
                elseif distToTarget > 5 then targetSpeedKmh = 4.0 + (distToTarget - 5) * (4.0 / 5.0)
                else targetSpeedKmh = 4.0 end
                AutoDrive.C.maxSpeed = targetSpeedKmh / 3.6
                local rel = carRoot.CFrame:PointToObjectSpace(activeObj.target)
                if rcd and rcd.phys then
                    if speedKmh > (targetSpeedKmh + 2.0) then
                        local brakeAmt = math.clamp((speedKmh - targetSpeedKmh) / 10.0, 0.25, 0.85)
                        rcd.phys.throttle = 0
                        rcd.phys.brake = brakeAmt
                    else
                        local throttleAmt = math.clamp(targetSpeedKmh / 22.0, 0.15, 0.45)
                        rcd.phys.throttle = throttleAmt
                        rcd.phys.brake = 0
                    end
                    rcd.phys.steerIn = math.clamp(rel.X * 0.18, -0.65, 0.65)
                end
            end
        end
        local targetBehind = false
        if carPosNow and carRoot then
            local toTarget = activeObj.target - carPosNow
            targetBehind = toTarget:Dot(carRoot.CFrame.LookVector) < -1.0
        end
        local now = os.clock()
        if distToTarget < bestDistanceToTarget - 2.0 then
            bestDistanceToTarget = distToTarget
            lastProgressAt = now
        end
        local passedCurrentCheckpoint = not activeObj.isStop and distToTarget <= PASS_THROUGH_RADIUS and targetBehind and speedKmh >= 8
        local driveActive = isAutoDriveActive()
        if driveActive then driveInactiveSince = nil
        else driveInactiveSince = driveInactiveSince or now end
        if passedCurrentCheckpoint then
            if rcd and rcd.phys then
                rcd.phys.throttle = 1
                rcd.phys.brake = 0
            end
        elseif not inBox and not driveActive
            and driveInactiveSince and (now - driveInactiveSince) >= 1.2
            and (now - lastRouteRestartAt) >= ROUTE_RESTART_COOLDOWN
            and (speedKmh < 8 or (now - lastProgressAt) >= 4.0) then
            applyAutoDriveParams(activeObj.isStop)
            local ok = AutoDrive.request(activeObj.target, { snap = false, stopNavOnCancel = false })
            if ok ~= false then AutoDrive.start() end
            lastRouteRestartAt = now
            lastDriveRefreshT = now
            lastProgressAt = now
            bestDistanceToTarget = distToTarget
        end
        if not passedCurrentCheckpoint and not activeObj.isStop
            and distToTarget > 20 and distToTarget <= 120
            and (now - lastProgressAt) >= NO_PROGRESS_TIMEOUT
            and (now - lastRouteRestartAt) >= ROUTE_RESTART_COOLDOWN then
            applyAutoDriveParams(false)
            local ok = AutoDrive.request(activeObj.target, { snap = false, stopNavOnCancel = false })
            if ok ~= false then AutoDrive.start() end
            lastRouteRestartAt = now
            lastDriveRefreshT = now
            lastProgressAt = now
            bestDistanceToTarget = distToTarget
        end
        if carPosNow then
            if not isHoldingStopBox then
                if (carPosNow - (lastStuckPos or carPosNow)).Magnitude > 3.0 or speedKmh > 5 then
                    lastStuckPos = carPosNow
                    lastStuckT = os.clock()
                elseif (not activeObj.isStop and distToTarget > 12) or (activeObj.isStop and distToTarget > 35) then
                    local stillTime = os.clock() - lastStuckT
                    local limit = activeObj.isStop and 4.0 or CONFIG.STUCK_TIME_SEC
                    if stillTime > limit
                        and (now - lastUnstuckAt) >= UNSTUCK_COOLDOWN
                        and not passedCurrentCheckpoint then
                        lastUnstuckAt = now
                        performUnstuck(activeObj.target)
                        lastStuckPos = getCarState() or carPosNow
                        lastStuckT = os.clock()
                        lastProgressAt = os.clock()
                        bestDistanceToTarget = distToTarget
                        lastRouteRestartAt = os.clock()
                    end
                end
            end
            if os.clock() - stepStartTime > CONFIG.TIMEOUT_PER_CHK
                and (os.clock() - lastRouteRestartAt) >= ROUTE_RESTART_COOLDOWN
                and not passedCurrentCheckpoint and not isHoldingStopBox then
                applyAutoDriveParams(activeObj.isStop)
                local ok = AutoDrive.request(activeObj.target, { snap = false, stopNavOnCancel = false })
                if ok ~= false then AutoDrive.start() end
                stepStartTime = os.clock()
                lastStuckT = os.clock()
                lastRouteRestartAt = os.clock()
                lastProgressAt = os.clock()
                bestDistanceToTarget = distToTarget
            end
        end
    end
    AutoDrive.stop(questStateRecoveryRequested and "quest_state_lost" or "quest_done")
    task.wait(0.3)
    claimAllDropsAndSellInventory()
    if isRefuelNeeded(true) then
        ensureFuelReady(true)
    end
    if questStateRecoveryRequested then
        task.wait(1.0)
    else
        -- ⏱️ รอนานขึ้นก่อนวนรอบใหม่
        print(string.format("[AutoQuest] 🔄 รอ %.1f วินาทีก่อนวนรอบใหม่...", CONFIG.LOOP_DELAY))
        task.wait(CONFIG.LOOP_DELAY)
    end
    claimAllDropsAndSellInventory()
end

