local function driveToFuelAndRefuel(timeout)
    if not _G.AutoQuestRunning then return false end
    timeout = timeout or 120
    local carPos = getCarState()
    local station = getNearestFuelStation(carPos)
    if not station then return false end
    applyAutoDriveParams(true)
    local ok = AutoDrive.request(station.pos, { snap = false, stopNavOnCancel = false })
    if ok then AutoDrive.start() else return false end
    local startTime = os.clock()
    local lastPos = carPos
    local lastMoveT = os.clock()
    while _G.AutoQuestRunning do
        task.wait(0.04)
        applyCorneringGripAssist()
        maintainHooks()
        local curPos = getCarState()
        if not curPos then break end
        local distToStation = (curPos - station.pos).Magnitude
        if distToStation > 65 then AutoDrive.C.maxSpeed = CONFIG.CRUISE_SPEED_MPS
        elseif distToStation > 25 then AutoDrive.C.maxSpeed = 30.0
        elseif distToStation > 12 then AutoDrive.C.maxSpeed = 12.0
        else AutoDrive.C.maxSpeed = 4.5 end
        if distToStation <= 7.0 then
            pcall(function() AutoDrive.stop("reached_fuel_station") end)
            local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
            if rcd and rcd.phys then
                rcd.phys.throttle = 0
                rcd.phys.brake = 1
                rcd.phys.steerIn = 0
                rcd.phys.v = Vector3.new(0, 0, 0)
                rcd.phys.w = Vector3.new(0, 0, 0)
            end
            task.wait(0.3)
            for attempt = 1, 4 do
                if requestServerRefuel(station.npcId) then break end
                task.wait(0.4)
            end
            task.wait(0.5)
            return true
        end
        if isAutoDriveActive() == false and distToStation > 7.0 then
            AutoDrive.request(station.pos, { snap = false, stopNavOnCancel = false })
            AutoDrive.start()
        end
        local rcd = (getrenv and getrenv().shared.RCDrive) or shared.RCDrive
        local speedKmh = rcd and rcd.phys and rcd.phys.v and (rcd.phys.v.Magnitude * 3.6) or 0
        if (curPos - lastPos).Magnitude > 2 or speedKmh > 2 then
            lastPos = curPos
            lastMoveT = os.clock()
        else
            local stillT = os.clock() - lastMoveT
            if distToStation > 8 and stillT > CONFIG.STUCK_TIME_SEC then
                performUnstuck(station.pos)
                lastPos = getCarState() or curPos
                lastMoveT = os.clock()
            end
        end
        if os.clock() - startTime > timeout then
            pcall(function() AutoDrive.stop("fuel_timeout") end)
            break
        end
    end
    return false
end

