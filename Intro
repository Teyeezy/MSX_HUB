    STATS.isRunning = false
    if mainThread then pcall(function() task.cancel(mainThread) end) end
    pcall(function() AutoDrive.stop("user_stop") end)
    if blinkTween then pcall(function() blinkTween:Cancel() end) end
    pcall(function() if _G.RaycityQuestGui then _G.RaycityQuestGui:Destroy() end end)
    print("[MSX HUB] หยุดเรียบร้อย")
end

